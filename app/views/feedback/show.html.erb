<% if @csat_response.respondent.present? %>
  <p class="text-xs text-gray-500 mb-6">Hi <strong><%= @csat_response.respondent.name %></strong>, we'd love to hear about your experience.</p>
<% else %>
  <p class="text-xs text-gray-500 mb-6">We'd love to hear about your experience.</p>
<% end %>

<%= form_with model: @csat_response, url: submit_feedback_path(token: @csat_response.token), method: :post, data: { turbo: false } do |f| %>
  <% if @csat_response.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3 text-xs text-red-700">
      <ul class="list-disc list-inside">
        <% @csat_response.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Service Rating -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-900 mb-2">How would you rate our service?</label>
    <div data-controller="star-rating" class="flex items-center gap-1">
      <%= f.hidden_field :service_rating, value: @csat_response.service_rating, data: { star_rating_target: "input" } %>
      <% (1..5).each do |i| %>
        <button type="button"
                data-action="click->star-rating#select"
                data-star-rating-target="star"
                data-value="<%= i %>"
                class="focus:outline-none transition">
          <svg class="h-8 w-8 <%= @csat_response.service_rating.to_i >= i ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Support Rating -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-900 mb-2">How would you rate our support?</label>
    <div data-controller="star-rating" class="flex items-center gap-1">
      <%= f.hidden_field :support_rating, value: @csat_response.support_rating, data: { star_rating_target: "input" } %>
      <% (1..5).each do |i| %>
        <button type="button"
                data-action="click->star-rating#select"
                data-star-rating-target="star"
                data-value="<%= i %>"
                class="focus:outline-none transition">
          <svg class="h-8 w-8 <%= @csat_response.support_rating.to_i >= i ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Would Recommend -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-900 mb-2">Would you recommend us?</label>
    <div class="flex items-center gap-4">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.radio_button :would_recommend, true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300", checked: @csat_response.would_recommend == true %>
        <span class="text-sm text-gray-700">Yes</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.radio_button :would_recommend, false, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300", checked: @csat_response.would_recommend == false %>
        <span class="text-sm text-gray-700">No</span>
      </label>
    </div>
  </div>

  <!-- Improvement Suggestion -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-900 mb-2">What can we improve? <span class="text-gray-400 font-normal">(optional)</span></label>
    <%= f.text_area :improvement_suggestion, rows: 3, placeholder: "Tell us what we could do better...", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 resize-none" %>
  </div>

  <!-- Additional Comments -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-900 mb-2">Additional comments <span class="text-gray-400 font-normal">(optional)</span></label>
    <%= f.text_area :additional_comments, rows: 3, placeholder: "Anything else you'd like to share...", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 resize-none" %>
  </div>

  <!-- Submit -->
  <div>
    <%= f.submit "Submit Feedback", class: "w-full rounded-lg bg-indigo-600 px-4 py-3 text-sm font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
  </div>
<% end %>
