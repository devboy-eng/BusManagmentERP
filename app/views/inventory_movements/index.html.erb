<% content_for :page_title, "Inventory Movements" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Inventory Movements</h2>
    <p class="text-xs text-gray-500 mt-1"><%= @pagy.count %> total movements</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_tag inventory_movements_path, method: :get, class: "flex items-center gap-2" do %>
      <%= select_tag :movement_type, options_for_select([["All Types", ""]] + InventoryMovement.movement_types.keys.map { |t| [t.humanize, t] }, params[:movement_type]), class: "rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      <%= submit_tag "Filter", class: "rounded-lg bg-gray-100 border border-gray-300 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition cursor-pointer" %>
      <% if params[:movement_type].present? %>
        <%= link_to "Clear", inventory_movements_path, class: "text-xs text-gray-500 hover:text-gray-900 transition" %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Spare Part</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Warehouse</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Performed By</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @movements.each do |movement| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs text-gray-500"><%= movement.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= movement.spare_part&.name %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= movement.warehouse&.name %></td>
            <td class="px-4 py-3">
              <span class="text-xs font-medium <%= movement.purchase_in? || movement.return_in? ? 'text-green-600' : 'text-red-600' %>">
                <%= movement.purchase_in? || movement.return_in? ? "+" : "-" %><%= movement.quantity %>
              </span>
            </td>
            <td class="px-4 py-3">
              <% type_colors = { "purchase_in" => "bg-green-100 text-green-800", "repair_out" => "bg-red-100 text-red-800", "return_in" => "bg-blue-100 text-blue-800", "adjustment" => "bg-yellow-100 text-yellow-800", "transfer" => "bg-purple-100 text-purple-800", "damage" => "bg-red-100 text-red-800" } %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= type_colors[movement.movement_type] || 'bg-gray-100 text-gray-800' %>">
                <%= movement.movement_type.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= movement.notes || "-" %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= movement.performed_by&.name || "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @movements.empty? %>
    <div class="text-center py-12">
      <p class="mt-3 text-xs text-gray-500">No inventory movements found.</p>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500">Showing <%= @pagy.from %> to <%= @pagy.to %> of <%= @pagy.count %> results</p>
      <nav class="flex items-center gap-1">
        <% if @pagy.prev %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.prev)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Prev<% end %>
        <% end %>
        <% @pagy.series.each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "rounded-lg px-3 py-1.5 text-xs #{item == @pagy.page ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" %>
          <% elsif item.is_a?(String) %>
            <span class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs text-white"><%= item %></span>
          <% elsif item == :gap %>
            <span class="px-2 text-gray-500">...</span>
          <% end %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.next)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Next<% end %>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>
