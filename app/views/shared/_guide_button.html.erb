<%# Usage: render "shared/guide_button", section: "chat" %>
<%# Compact mode: render "shared/guide_button", section: "chat", compact: true %>

<% guide_id = "guide-modal-#{section}" %>
<% compact = local_assigns.fetch(:compact, false) %>

<style>.guide-dialog::backdrop{background:rgba(0,0,0,.3)}</style>

<button type="button" onclick="document.getElementById('<%= guide_id %>').showModal()" class="<%= compact ? 'inline-flex items-center gap-1 rounded-md border border-gray-300 bg-white px-2 py-1 text-[11px] font-medium text-gray-500 hover:bg-gray-50 hover:text-indigo-600 transition' : 'inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-50 hover:text-indigo-600 transition' %>" title="Help & Guide">
  <svg class="<%= compact ? 'h-3 w-3' : 'h-4 w-4' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
  </svg>
  Guide
</button>

<dialog id="<%= guide_id %>" class="guide-dialog" style="margin:auto; padding:0; border:none; border-radius:0.75rem; width:520px; max-width:90vw; max-height:70vh; background:transparent;" onclick="if(event.target===this) this.close()">
  <div style="background:#fff; border-radius:0.75rem; box-shadow:0 20px 40px rgba(0,0,0,.15); display:flex; flex-direction:column; max-height:65vh; overflow:hidden;">

    <%# Header %>
    <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 20px; border-bottom:1px solid #f3f4f6; flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:8px;">
        <svg style="width:16px; height:16px; color:#4f46e5;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        <span style="font-size:14px; font-weight:600; color:#111827;">Feature Guide</span>
      </div>
      <button type="button" onclick="this.closest('dialog').close()" style="color:#9ca3af; cursor:pointer; background:none; border:none; padding:4px;">
        <svg style="width:16px; height:16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <%# Scrollable Body %>
    <div style="flex:1; overflow-y:auto; padding:16px 20px;">
      <%= render "shared/guide_content_#{section}" %>
    </div>

    <%# Footer %>
    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 20px; border-top:1px solid #f3f4f6; background:#f9fafb; border-radius:0 0 0.75rem 0.75rem; flex-shrink:0;">
      <%= link_to "View Complete Guide", whatsapp_guide_path, style: "font-size:11px; color:#4f46e5; text-decoration:none; font-weight:500;" %>
      <button type="button" onclick="this.closest('dialog').close()" style="border-radius:8px; background:#e5e7eb; padding:6px 14px; font-size:12px; font-weight:500; color:#374151; border:none; cursor:pointer;">Close</button>
    </div>

  </div>
</dialog>
