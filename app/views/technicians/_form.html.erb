<%= form_with(model: technician, class: "space-y-6") do |f| %>
  <% if technician.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-xs font-medium text-red-700"><%= pluralize(technician.errors.count, "error") %> prevented this technician from being saved:</p>
      <ul class="mt-2 list-disc list-inside text-xs text-red-600">
        <% technician.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Name *</label>
      <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter name" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Phone</label>
      <%= f.text_field :phone, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter phone number" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Employee ID</label>
      <%= f.text_field :employee_id, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter employee ID" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Specialization</label>
      <%= f.text_field :specialization, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "e.g. Engine, Electrical" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Hourly Rate</label>
      <%= f.number_field :hourly_rate, step: 0.01, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter hourly rate" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Status</label>
      <%= f.select :status, [["Active", "active"], ["Inactive", "inactive"]], {}, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Joined On</label>
      <%= f.date_field :joined_on, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Branch</label>
      <%= f.collection_select :branch_id, @branches, :id, :name, { include_blank: "Select branch" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1.5">Notes</label>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Additional notes" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", technicians_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
  </div>
<% end %>
