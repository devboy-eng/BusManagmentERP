<%= form_with(model: menu, url: menu.persisted? ? whatsapp_menu_path(menu) : whatsapp_menus_path, class: "space-y-5", data: { controller: "menu-items" }) do |f| %>
  <% if menu.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-3">
      <p class="text-xs font-medium text-red-700"><%= pluralize(menu.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc pl-4">
        <% menu.errors.full_messages.each do |msg| %>
          <li class="text-[11px] text-red-600"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. Services Menu" %>
  </div>

  <div data-controller="keyword-tags">
    <label class="block text-xs font-medium text-gray-700 mb-1">Trigger Keywords</label>
    <div data-action="click->keyword-tags#focusInput" data-keyword-tags-target="tagsContainer" class="w-full rounded-lg border border-gray-300 px-2 py-1.5 flex flex-wrap items-center gap-1.5 min-h-[38px] focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 cursor-text">
      <input type="text"
             data-keyword-tags-target="input"
             data-action="keydown->keyword-tags#handleKeydown input->keyword-tags#handleInput"
             class="flex-1 min-w-[120px] border-none outline-none text-xs py-0.5 px-1 bg-transparent"
             placeholder="Type keyword and press Enter...">
    </div>
    <%= f.hidden_field :trigger_keyword, data: { "keyword-tags-target": "hiddenField" } %>
    <p class="text-[11px] text-gray-400 mt-1">Type each keyword and press <strong>Enter</strong> or <strong>comma</strong> to add. Any of these words will trigger the menu. Case-insensitive.</p>
  </div>

  <div>
    <%= f.label :header_text, "Header (optional)", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :header_text, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. Our Services", maxlength: 60 %>
    <p class="text-[11px] text-gray-400 mt-1">Max 60 characters. Shown as bold header in the WhatsApp message.</p>
  </div>

  <div>
    <%= f.label :body_text, "Body Text", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_area :body_text, rows: 3, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "Please select an option from the menu below..." %>
  </div>

  <div>
    <%= f.label :footer_text, "Footer (optional)", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :footer_text, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. Reply anytime for help", maxlength: 60 %>
    <p class="text-[11px] text-gray-400 mt-1">Max 60 characters. Shown as small footer text below the menu.</p>
  </div>

  <div>
    <%= f.label :button_text, "Button Label", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :button_text, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "Menu", maxlength: 20 %>
    <p class="text-[11px] text-gray-400 mt-1">Max 20 characters. The button the customer taps to open the list.</p>
  </div>

  <!-- Menu Items -->
  <div>
    <label class="block text-xs font-medium text-gray-700 mb-2">Menu Items</label>
    <p class="text-[11px] text-gray-400 mb-3">Add 1-10 items that will appear in the WhatsApp list popup. Each item needs a title (max 24 chars) and a reply message.</p>

    <div data-menu-items-target="container" class="space-y-3">
      <% items = menu.parsed_menu_items.presence || [{ "id" => SecureRandom.hex(4), "title" => "", "description" => "", "reply_text" => "" }] %>
      <% items.each_with_index do |item, index| %>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 relative" data-menu-items-target="item">
          <button type="button" data-action="menu-items#remove" class="absolute top-2 right-2 text-gray-400 hover:text-red-500 transition" title="Remove item">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>

          <div class="grid grid-cols-2 gap-3 mb-3">
            <div>
              <label class="block text-[11px] font-medium text-gray-600 mb-1">Title <span class="text-red-400">*</span></label>
              <input type="text" data-field="title" value="<%= item["title"] %>" maxlength="24" class="w-full rounded-lg border border-gray-300 px-3 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" placeholder="e.g. Check Balance">
            </div>
            <div>
              <label class="block text-[11px] font-medium text-gray-600 mb-1">Description (optional)</label>
              <input type="text" data-field="description" value="<%= item["description"] %>" maxlength="72" class="w-full rounded-lg border border-gray-300 px-3 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" placeholder="Short description">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-medium text-gray-600 mb-1">Reply Text <span class="text-red-400">*</span></label>
            <textarea data-field="reply_text" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" placeholder="Reply sent when customer selects this item..."><%= item["reply_text"] %></textarea>
          </div>
        </div>
      <% end %>
    </div>

    <button type="button" data-action="menu-items#add" class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-dashed border-gray-300 px-3 py-2 text-xs font-medium text-gray-500 hover:border-indigo-400 hover:text-indigo-600 transition" data-menu-items-target="addButton">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Add Item
    </button>
  </div>

  <!-- Hidden field to hold serialized JSON -->
  <%= f.hidden_field :menu_items, data: { "menu-items-target": "hiddenField" } %>

  <div class="flex items-center gap-2 pt-2">
    <%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
    <%= f.label :active, "Active", class: "text-xs font-medium text-gray-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", whatsapp_menus_path, class: "text-xs text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
