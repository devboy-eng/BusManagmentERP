<% content_for :page_title, "Dashboard" %>

<!-- Stats Cards -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Total Customers</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @total_customers %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-indigo-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
      </div>
    </div>
    <p class="text-[11px] text-green-600 mt-2"><%= @active_customers %> active</p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Total Leads</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @total_leads %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-blue-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
      </div>
    </div>
    <p class="text-[11px] text-yellow-600 mt-2"><%= @pending_leads %> pending</p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Work in Process</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @wip_leads %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-green-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" /></svg>
      </div>
    </div>
    <p class="text-[11px] text-blue-600 mt-2">Active leads</p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Not Interested</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @not_interested_leads %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-red-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
      </div>
    </div>
    <p class="text-[11px] text-red-600 mt-2">Closed leads</p>
  </div>
</div>

<!-- Recent Tables -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="rounded-xl border border-gray-200 bg-white">
    <div class="flex items-center justify-between p-5 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900">Recent Customers</h3>
      <%= link_to "View All", customers_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
    <div class="p-5">
      <% if @recent_customers.any? %>
        <div class="space-y-2.5">
          <% @recent_customers.each do |customer| %>
            <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3">
              <div>
                <p class="text-xs font-medium text-gray-900"><%= customer.name %></p>
                <p class="text-[11px] text-gray-500"><%= customer.phone %></p>
              </div>
              <%= status_badge(customer.status, :customer) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No customers yet.</p>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white">
    <div class="flex items-center justify-between p-5 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900">Recent Leads</h3>
      <%= link_to "View All", leads_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
    <div class="p-5">
      <% if @recent_leads.any? %>
        <div class="space-y-2.5">
          <% @recent_leads.each do |lead| %>
            <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3">
              <div>
                <p class="text-xs font-medium text-gray-900"><%= lead.name %></p>
                <p class="text-[11px] text-gray-500"><%= lead.phone %></p>
              </div>
              <%= status_badge(lead.status, :lead) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No leads yet.</p>
      <% end %>
    </div>
  </div>
</div>
