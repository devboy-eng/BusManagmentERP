<% content_for :page_title, "Dashboard" %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <%= link_to job_cards_path(status: "checked_in"), class: "rounded-xl border border-gray-200 bg-white p-4 hover:shadow-md transition" do %>
    <p class="text-[11px] text-gray-500">Checked In Today</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @vehicles_today %></p>
  <% end %>

  <%= link_to job_cards_path, class: "rounded-xl border border-gray-200 bg-white p-4 hover:shadow-md transition" do %>
    <p class="text-[11px] text-gray-500">Active Job Cards</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @active_job_cards %></p>
  <% end %>

  <%= link_to job_cards_path(status: "estimate_sent"), class: "rounded-xl border border-gray-200 bg-white p-4 hover:shadow-md transition" do %>
    <p class="text-[11px] text-gray-500">Awaiting Approval</p>
    <p class="text-2xl font-bold text-yellow-600 mt-1"><%= @awaiting_approval %></p>
  <% end %>

  <%= link_to job_cards_path(status: "in_progress"), class: "rounded-xl border border-gray-200 bg-white p-4 hover:shadow-md transition" do %>
    <p class="text-[11px] text-gray-500">In Workshop</p>
    <p class="text-2xl font-bold text-blue-600 mt-1"><%= @in_workshop %></p>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500">Completed Today</p>
    <p class="text-2xl font-bold text-green-600 mt-1"><%= @completed_today %></p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500">Revenue This Month</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= number_to_currency(@revenue_this_month, unit: "\u20B9", precision: 0) %></p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500">Pending Payments</p>
    <p class="text-2xl font-bold text-red-600 mt-1"><%= number_to_currency(@pending_payments, unit: "\u20B9", precision: 0) %></p>
  </div>

  <%= link_to low_stock_spare_parts_path, class: "rounded-xl border border-gray-200 bg-white p-4 hover:shadow-md transition" do %>
    <p class="text-[11px] text-gray-500">Low Stock Alerts</p>
    <p class="text-2xl font-bold text-orange-600 mt-1"><%= @low_stock_count %></p>
  <% end %>
</div>

<!-- Recent Job Cards -->
<div class="rounded-xl border border-gray-200 bg-white overflow-hidden mb-6">
  <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
    <h3 class="text-sm font-semibold text-gray-900">Recent Job Cards</h3>
    <%= link_to "View All", job_cards_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Job Card #</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Vehicle</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Customer</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Status</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Checked In</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @recent_job_cards.each do |jc| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 text-xs font-medium"><%= link_to jc.job_card_number, job_card_path(jc), class: "text-indigo-600 hover:text-indigo-500" %></td>
            <td class="px-4 py-2 text-xs text-gray-600"><%= jc.vehicle.registration_number %></td>
            <td class="px-4 py-2 text-xs text-gray-600"><%= jc.customer.name %></td>
            <td class="px-4 py-2"><%= status_badge(jc.status, :job_card) %></td>
            <td class="px-4 py-2 text-xs text-gray-500"><%= jc.checked_in_at&.strftime("%d %b %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @recent_job_cards.empty? %>
    <p class="text-center py-8 text-xs text-gray-500">No job cards yet. <%= link_to "Create your first job card", new_job_card_path, class: "text-indigo-600" %>.</p>
  <% end %>
</div>
