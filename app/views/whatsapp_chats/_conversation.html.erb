<%= link_to whatsapp_chat_path(conversation),
  class: "flex items-center gap-3 px-4 py-3 border-b border-gray-100 hover:bg-gray-50 transition #{selected ? 'bg-indigo-50 border-l-2 border-l-indigo-500' : ''}",
  data: { turbo_frame: "_top", conversation_id: conversation.id } do %>

  <!-- Avatar -->
  <% avatar_color = case conversation.contact_type
                    when 'Customer' then 'bg-emerald-500'
                    when 'Lead' then 'bg-blue-500'
                    else 'bg-gray-400'
                    end %>
  <% show_initial = conversation.display_name.present? && conversation.display_name.first&.match?(/[a-zA-Z]/) %>
  <div class="h-10 w-10 rounded-full flex-shrink-0 flex items-center justify-center text-sm font-semibold text-white <%= avatar_color %>">
    <% if show_initial %>
      <%= conversation.display_name.first.upcase %>
    <% else %>
      <svg class="h-5 w-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v1.2c0 .7.5 1.2 1.2 1.2h16.8c.7 0 1.2-.5 1.2-1.2v-1.2c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
    <% end %>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <div class="flex items-center justify-between">
      <p class="text-xs font-semibold text-gray-900 truncate"><%= conversation.display_name %></p>
      <% if conversation.last_message_at %>
        <span class="text-[10px] text-gray-400 flex-shrink-0 ml-2">
          <%= conversation.last_message_at.strftime(conversation.last_message_at.to_date == Date.today ? "%I:%M %p" : "%b %d") %>
        </span>
      <% end %>
    </div>
    <div class="flex items-center justify-between mt-0.5">
      <p class="text-[11px] text-gray-500 truncate"><%= conversation.last_message_preview %></p>
      <% if conversation.unread_count > 0 %>
        <span class="ml-2 flex-shrink-0 inline-flex items-center justify-center h-4 min-w-[16px] rounded-full bg-green-500 px-1 text-[10px] font-bold text-white">
          <%= conversation.unread_count %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
