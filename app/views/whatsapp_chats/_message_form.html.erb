<div class="bg-white border-t border-gray-200 px-4 py-3">
  <% if defined?(error) && error.present? %>
    <div class="mb-2 rounded-lg bg-red-50 border border-red-200 p-2 text-[11px] text-red-600"><%= error %></div>
  <% end %>

  <%# Quick response autocomplete dropdown (hidden by default) %>
  <div id="quick-response-dropdown" class="hidden mb-2 max-h-40 overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-lg" data-whatsapp-chat-target="quickResponseDropdown">
  </div>

  <%= form_with url: send_reply_whatsapp_chat_path(conversation), method: :post, class: "flex items-end gap-2", data: { whatsapp_chat_target: "form" } do |f| %>
    <%# Attachment button %>
    <button type="button" class="flex-shrink-0 h-9 w-9 rounded-full hover:bg-gray-100 flex items-center justify-center transition" data-action="click->whatsapp-chat#triggerFileInput" title="Attach file">
      <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
      </svg>
    </button>
    <input type="file" class="hidden" data-whatsapp-chat-target="fileInput" data-action="change->whatsapp-chat#handleFileSelected" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx">

    <div class="flex-1">
      <%# File preview area %>
      <div id="file-preview" class="hidden mb-2 p-2 rounded-lg bg-gray-50 border border-gray-200 flex items-center gap-2" data-whatsapp-chat-target="filePreview">
        <span class="text-xs text-gray-600" data-whatsapp-chat-target="fileName"></span>
        <button type="button" class="text-red-500 hover:text-red-600 text-xs ml-auto" data-action="click->whatsapp-chat#removeFile">Remove</button>
      </div>

      <textarea name="message_body"
                rows="1"
                placeholder="Type a message... (/ for quick replies)"
                class="w-full resize-none rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-green-500 focus:ring-1 focus:ring-green-500 outline-none"
                data-whatsapp-chat-target="input"
                data-action="keydown->whatsapp-chat#handleKeydown input->whatsapp-chat#autoResize input->whatsapp-chat#checkQuickResponse"></textarea>
    </div>

    <%# Schedule button %>
    <button type="button" class="flex-shrink-0 h-9 w-9 rounded-full hover:bg-gray-100 flex items-center justify-center transition" data-action="click->whatsapp-chat#toggleScheduleModal" title="Schedule message">
      <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </button>

    <%# Send button %>
    <button type="submit" class="flex-shrink-0 h-9 w-9 rounded-full bg-green-500 hover:bg-green-600 flex items-center justify-center transition">
      <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
      </svg>
    </button>
  <% end %>

  <%# Schedule modal %>
  <div id="schedule-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/30" data-whatsapp-chat-target="scheduleModal">
    <div class="bg-white rounded-xl shadow-xl p-6 w-96 max-w-[90vw]">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Schedule Message</h3>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Message</label>
          <textarea rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" data-whatsapp-chat-target="scheduleBody" placeholder="Type your message..."></textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Send At</label>
          <input type="datetime-local" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" data-whatsapp-chat-target="scheduleAt">
        </div>
      </div>
      <div class="flex items-center justify-end gap-3 mt-4">
        <button type="button" class="text-xs text-gray-500 hover:text-gray-700" data-action="click->whatsapp-chat#toggleScheduleModal">Cancel</button>
        <button type="button" class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-xs font-medium text-white hover:bg-indigo-500 transition" data-action="click->whatsapp-chat#submitSchedule">Schedule</button>
      </div>
    </div>
  </div>
</div>
