<!-- Chat Header -->
<div class="flex items-center gap-3 px-4 py-3 bg-white border-b border-gray-200 flex-shrink-0">
  <% avatar_color = case conversation.contact_type
                    when 'Customer' then 'bg-emerald-500'
                    when 'Lead' then 'bg-blue-500'
                    else 'bg-gray-400'
                    end %>
  <% show_initial = conversation.display_name.present? && conversation.display_name.first&.match?(/[a-zA-Z]/) %>
  <div class="h-9 w-9 rounded-full flex items-center justify-center text-sm font-semibold text-white <%= avatar_color %>">
    <% if show_initial %>
      <%= conversation.display_name.first.upcase %>
    <% else %>
      <svg class="h-5 w-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v1.2c0 .7.5 1.2 1.2 1.2h16.8c.7 0 1.2-.5 1.2-1.2v-1.2c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
    <% end %>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-semibold text-gray-900 truncate"><%= conversation.display_name %></p>
    <p class="text-[11px] text-gray-500">
      <%= conversation.contact_phone %>
      <% if conversation.contact %>
        &middot;
        <% if conversation.contact_type == "Customer" %>
          <%= link_to "View Customer", customer_path(conversation.contact), class: "text-indigo-600 hover:underline" %>
        <% else %>
          <%= link_to "View Lead", lead_path(conversation.contact), class: "text-indigo-600 hover:underline" %>
        <% end %>
      <% end %>
      <% if conversation.assigned? %>
        &middot;
        <span class="inline-flex items-center gap-1 text-[11px]">
          <span class="h-4 w-4 rounded-full bg-indigo-500 flex items-center justify-center text-[9px] font-bold text-white"><%= conversation.assigned_user.name&.first&.upcase %></span>
          <span class="text-indigo-600"><%= conversation.assigned_user.name %></span>
        </span>
      <% end %>
    </p>
  </div>

  <%# Header actions %>
  <div class="flex items-center gap-1">
    <%# Assignment dropdown %>
    <div class="relative" data-controller="dropdown">
      <button data-action="click->dropdown#toggle" class="h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition" title="Assign conversation">
        <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      </button>
      <div class="hidden absolute right-0 top-full mt-1 w-48 rounded-lg bg-white border border-gray-200 shadow-lg z-50 py-1" data-dropdown-target="menu">
        <p class="px-3 py-1.5 text-[11px] font-semibold text-gray-400 uppercase">Assign to</p>
        <% User.active.each do |user| %>
          <%= link_to assign_whatsapp_chat_path(conversation, user_id: user.id), data: { turbo_method: :post }, class: "flex items-center gap-2 px-3 py-1.5 text-xs hover:bg-gray-50 transition #{conversation.assigned_to?(user) ? 'text-indigo-600 font-medium' : 'text-gray-700'}" do %>
            <span class="h-5 w-5 rounded-full bg-indigo-100 flex items-center justify-center text-[10px] font-bold text-indigo-600"><%= user.name&.first&.upcase %></span>
            <%= user.name %>
            <% if conversation.assigned_to?(user) %>
              <svg class="h-3 w-3 ml-auto text-indigo-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            <% end %>
          <% end %>
        <% end %>
        <% if conversation.assigned? %>
          <div class="border-t border-gray-100 mt-1 pt-1">
            <%= link_to unassign_whatsapp_chat_path(conversation), data: { turbo_method: :delete }, class: "block px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 transition" do %>
              Unassign
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Search toggle %>
    <button class="h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition" data-action="click->whatsapp-chat#toggleSearch" title="Search messages">
      <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
    </button>
  </div>
</div>

<%# Search bar (hidden by default) %>
<div id="chat-search-bar" class="hidden px-4 py-2 bg-white border-b border-gray-200" data-whatsapp-chat-target="searchBar">
  <div class="flex items-center gap-2">
    <input type="text"
           placeholder="Search messages in this conversation..."
           class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none"
           data-whatsapp-chat-target="messageSearch"
           data-action="input->whatsapp-chat#searchMessages">
    <button class="text-xs text-gray-500 hover:text-gray-700" data-action="click->whatsapp-chat#toggleSearch">Close</button>
  </div>
  <div id="search-results" class="mt-2 max-h-32 overflow-y-auto hidden" data-whatsapp-chat-target="searchResults"></div>
</div>

<!-- Messages Container -->
<div class="flex-1 overflow-y-auto px-4 py-4 space-y-1" id="messages-container"
     data-whatsapp-chat-target="messages"
     data-conversation-id="<%= conversation.id %>">
  <% messages.each do |message| %>
    <%= render partial: "whatsapp_chats/message", locals: { message: message } %>
  <% end %>

  <% if messages.empty? %>
    <div class="flex items-center justify-center h-full">
      <p class="text-xs text-gray-400">No messages yet. Send the first message below.</p>
    </div>
  <% end %>
</div>

<!-- Message Form -->
<div id="message-form" class="flex-shrink-0">
  <%= render partial: "whatsapp_chats/message_form", locals: { conversation: conversation } %>
</div>
