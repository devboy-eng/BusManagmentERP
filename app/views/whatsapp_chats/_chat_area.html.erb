<!-- Chat Header -->
<div class="flex items-center gap-3 px-4 py-3 bg-white border-b border-gray-200 flex-shrink-0">
  <% avatar_color = case conversation.contact_type
                    when 'Customer' then 'bg-emerald-500'
                    when 'Lead' then 'bg-blue-500'
                    else 'bg-gray-400'
                    end %>
  <% show_initial = conversation.display_name.present? && conversation.display_name.first&.match?(/[a-zA-Z]/) %>
  <div class="h-9 w-9 rounded-full flex items-center justify-center text-sm font-semibold text-white <%= avatar_color %>">
    <% if show_initial %>
      <%= conversation.display_name.first.upcase %>
    <% else %>
      <svg class="h-5 w-5 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v1.2c0 .7.5 1.2 1.2 1.2h16.8c.7 0 1.2-.5 1.2-1.2v-1.2c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
    <% end %>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-semibold text-gray-900 truncate"><%= conversation.display_name %></p>
    <p class="text-[11px] text-gray-500">
      <%= conversation.contact_phone %>
      <% if conversation.contact %>
        &middot;
        <% if conversation.contact_type == "Customer" %>
          <%= link_to "View Customer", customer_path(conversation.contact), class: "text-indigo-600 hover:underline" %>
        <% else %>
          <%= link_to "View Lead", lead_path(conversation.contact), class: "text-indigo-600 hover:underline" %>
        <% end %>
      <% end %>
      <% if conversation.assigned? %>
        &middot;
        <span class="inline-flex items-center gap-1 text-[11px]">
          <span class="h-4 w-4 rounded-full bg-indigo-500 flex items-center justify-center text-[9px] font-bold text-white"><%= conversation.assigned_user.name&.first&.upcase %></span>
          <span class="text-indigo-600"><%= conversation.assigned_user.name %></span>
        </span>
      <% end %>
    </p>
  </div>

  <%# Header actions %>
  <div class="flex items-center gap-1">
    <%# Assignment button — opens dialog %>
    <button type="button" onclick="document.getElementById('assign-dialog-<%= conversation.id %>').showModal()" class="h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition" title="Assign conversation">
      <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
      </svg>
    </button>

    <%# Save as Lead button — only show if conversation is NOT already linked to a lead/customer %>
    <% unless conversation.contact.present? %>
      <button type="button" onclick="document.getElementById('save-lead-dialog-<%= conversation.id %>').showModal()" class="h-8 w-8 rounded-full hover:bg-green-50 flex items-center justify-center transition" title="Save as Lead">
        <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
        </svg>
      </button>
    <% end %>

    <%# Search toggle %>
    <button class="h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition" data-action="click->whatsapp-chat#toggleSearch" title="Search messages">
      <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
    </button>
  </div>
</div>

<%# Search bar (hidden by default) %>
<div id="chat-search-bar" class="hidden px-4 py-2 bg-white border-b border-gray-200" data-whatsapp-chat-target="searchBar">
  <div class="flex items-center gap-2">
    <input type="text"
           placeholder="Search messages in this conversation..."
           class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none"
           data-whatsapp-chat-target="messageSearch"
           data-action="input->whatsapp-chat#searchMessages">
    <button class="text-xs text-gray-500 hover:text-gray-700" data-action="click->whatsapp-chat#toggleSearch">Close</button>
  </div>
  <div id="search-results" class="mt-2 max-h-32 overflow-y-auto hidden" data-whatsapp-chat-target="searchResults"></div>
</div>

<!-- Messages Container -->
<div class="flex-1 overflow-y-auto px-4 py-4 space-y-1" id="messages-container"
     data-whatsapp-chat-target="messages"
     data-conversation-id="<%= conversation.id %>">
  <% messages.each do |message| %>
    <%= render partial: "whatsapp_chats/message", locals: { message: message } %>
  <% end %>

  <% if messages.empty? %>
    <div class="flex items-center justify-center h-full">
      <p class="text-xs text-gray-400">No messages yet. Send the first message below.</p>
    </div>
  <% end %>
</div>

<!-- Message Form -->
<div id="message-form" class="flex-shrink-0">
  <%= render partial: "whatsapp_chats/message_form", locals: { conversation: conversation } %>
</div>

<%# Save as Lead Dialog %>
<% unless conversation.contact.present? %>
  <style>.save-lead-dialog::backdrop{background:rgba(0,0,0,.3)}</style>
  <dialog id="save-lead-dialog-<%= conversation.id %>" class="save-lead-dialog" style="margin:auto;padding:0;border:none;border-radius:0.75rem;width:460px;max-width:90vw;background:transparent;" onclick="if(event.target===this) this.close()">
    <div style="background:#fff;border-radius:0.75rem;box-shadow:0 20px 40px rgba(0,0,0,.15);overflow:hidden;">
      <!-- Header -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" /></svg>
          <h3 class="text-sm font-semibold text-gray-900">Save as Lead</h3>
        </div>
        <button type="button" onclick="this.closest('dialog').close()" class="text-gray-400 hover:text-gray-600 transition">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <!-- Form -->
      <div class="px-5 py-4">
        <%= form_with url: send_to_lead_whatsapp_chat_path(conversation), method: :post, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Name <span class="text-red-400">*</span></label>
            <input type="text" name="lead[name]" value="<%= conversation.contact_name.presence || 'WhatsApp Lead' %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Phone <span class="text-red-400">*</span></label>
            <input type="text" name="lead[phone]" value="<%= conversation.contact_phone %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none bg-gray-50" readonly>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="lead[email]" value="" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" placeholder="customer@example.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Category</label>
            <select name="lead[category]" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none">
              <option value="">Select category...</option>
              <% Lead::CATEGORIES.each do |cat| %>
                <option value="<%= cat %>"><%= cat %></option>
              <% end %>
            </select>
          </div>
          <div class="flex items-center gap-3 pt-1">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-green-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              Save Lead
            </button>
            <button type="button" onclick="this.closest('dialog').close()" class="text-xs text-gray-500 hover:text-gray-700">Cancel</button>
          </div>
        <% end %>
      </div>
    </div>
  </dialog>
<% end %>

<%# Assign Conversation Dialog %>
<style>.assign-dialog::backdrop{background:rgba(0,0,0,.3)}</style>
<dialog id="assign-dialog-<%= conversation.id %>" class="assign-dialog" style="margin:auto;padding:0;border:none;border-radius:0.75rem;width:380px;max-width:90vw;background:transparent;" onclick="if(event.target===this) this.close()">
  <div style="background:#fff;border-radius:0.75rem;box-shadow:0 20px 40px rgba(0,0,0,.15);overflow:hidden;">
    <!-- Header -->
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
        <h3 class="text-sm font-semibold text-gray-900">Assign Conversation</h3>
      </div>
      <button type="button" onclick="this.closest('dialog').close()" class="text-gray-400 hover:text-gray-600 transition">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <!-- User List -->
    <div class="px-3 py-3 space-y-1 max-h-64 overflow-y-auto">
      <% if conversation.assigned? %>
        <div class="flex items-center gap-2 px-2 py-1.5 mb-2 rounded-lg bg-indigo-50 border border-indigo-100">
          <span class="h-6 w-6 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] font-bold text-white"><%= conversation.assigned_user.name&.first&.upcase %></span>
          <span class="text-xs text-indigo-700 flex-1">Assigned to <strong><%= conversation.assigned_user.name %></strong></span>
          <%= link_to unassign_whatsapp_chat_path(conversation), data: { turbo_method: :delete }, class: "text-[11px] text-red-500 hover:text-red-700 font-medium", onclick: "this.closest('dialog').close()" do %>
            Unassign
          <% end %>
        </div>
      <% end %>

      <% User.order(:name).each do |user| %>
        <% is_assigned = conversation.assigned? && conversation.assigned_user_id == user.id %>
        <%= link_to assign_whatsapp_chat_path(conversation, user_id: user.id), data: { turbo_method: :post }, class: "flex items-center gap-3 px-2 py-2 rounded-lg transition #{is_assigned ? 'bg-indigo-50 border border-indigo-200' : 'hover:bg-gray-50'}", onclick: "this.closest('dialog').close()" do %>
          <span class="h-7 w-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-semibold text-gray-600 <%= 'bg-indigo-500 text-white' if is_assigned %>">
            <%= user.name&.first&.upcase %>
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-medium text-gray-900 truncate"><%= user.name %></p>
            <p class="text-[11px] text-gray-400 truncate"><%= user.email %></p>
          </div>
          <% if is_assigned %>
            <svg class="h-4 w-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</dialog>
