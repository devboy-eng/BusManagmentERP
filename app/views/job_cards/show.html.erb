<% content_for :page_title, "Job Card #{@job_card.job_card_number}" %>

<!-- Header -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex items-center gap-3">
    <div>
      <h2 class="text-lg font-semibold text-gray-900"><%= @job_card.job_card_number %></h2>
      <div class="flex items-center gap-2 mt-1">
        <%= status_badge(@job_card.status, :job_card) %>
        <% priority_colors = { "normal" => "bg-gray-50 text-gray-700 border-gray-200", "urgent" => "bg-orange-50 text-orange-700 border-orange-200", "critical" => "bg-red-50 text-red-700 border-red-200" } %>
        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium <%= priority_colors[@job_card.priority] || priority_colors['normal'] %>">
          <%= @job_card.priority.titleize %> Priority
        </span>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to advance_status_job_card_path(@job_card), data: { turbo_method: :patch, turbo_confirm: "Advance status to next step?" }, class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.689c0-.864.933-1.405 1.683-.977l7.108 4.062a1.125 1.125 0 010 1.953l-7.108 4.062A1.125 1.125 0 013 16.811V8.69zM12.75 8.689c0-.864.933-1.405 1.683-.977l7.108 4.062a1.125 1.125 0 010 1.953l-7.108 4.062a1.125 1.125 0 01-1.683-.977V8.69z" /></svg>
      Advance Status
    <% end %>
    <%= link_to "#", class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition", onclick: "window.print(); return false;" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" /></svg>
      Print
    <% end %>
    <%= link_to edit_job_card_path(@job_card), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      Edit
    <% end %>
    <%= link_to job_cards_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to List
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main Content -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Vehicle & Customer Info -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Vehicle Information</h3>
        <dl class="space-y-3">
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Registration</dt>
            <dd class="text-xs mt-1">
              <%= link_to @job_card.vehicle.registration_number, vehicle_path(@job_card.vehicle), class: "text-indigo-600 hover:text-indigo-500 transition font-medium" %>
            </dd>
          </div>
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Make / Model</dt>
            <dd class="text-xs text-gray-900 mt-1"><%= @job_card.vehicle.make %> <%= @job_card.vehicle.model %></dd>
          </div>
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Fuel Type</dt>
            <dd class="text-xs text-gray-900 mt-1"><%= @job_card.vehicle.fuel_type&.titleize || "-" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Customer Information</h3>
        <dl class="space-y-3">
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Name</dt>
            <dd class="text-xs mt-1">
              <%= link_to @job_card.customer.name, customer_path(@job_card.customer), class: "text-indigo-600 hover:text-indigo-500 transition font-medium" %>
            </dd>
          </div>
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Phone</dt>
            <dd class="text-xs text-gray-900 mt-1"><%= @job_card.customer.phone %></dd>
          </div>
          <div class="rounded-lg bg-gray-50 p-3">
            <dt class="text-[11px] text-gray-500">Email</dt>
            <dd class="text-xs text-gray-900 mt-1"><%= @job_card.customer.email || "-" %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Service Details -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Service Details</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Service Type</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.service_type&.name || "General Service" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Service Advisor</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.service_advisor.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Branch</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.branch.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Odometer Reading</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.odometer_reading ? "#{number_with_delimiter(@job_card.odometer_reading)} km" : "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Checked In</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.checked_in_at&.strftime("%d %b %Y, %I:%M %p") || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Estimated Completion</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @job_card.estimated_completion_at&.strftime("%d %b %Y, %I:%M %p") || "-" %></dd>
        </div>
      </dl>
      <% if @job_card.customer_complaints.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Customer Complaints</dt>
          <dd class="text-xs text-gray-900 mt-1 whitespace-pre-line"><%= @job_card.customer_complaints %></dd>
        </div>
      <% end %>
      <% if @job_card.advisor_notes.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Advisor Notes</dt>
          <dd class="text-xs text-gray-900 mt-1 whitespace-pre-line"><%= @job_card.advisor_notes %></dd>
        </div>
      <% end %>
    </div>

    <!-- Timeline / Status Tracking -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Status Timeline</h3>
      <div class="space-y-3">
        <%
          timeline_events = []
          timeline_events << { label: "Checked In", time: @job_card.checked_in_at } if @job_card.checked_in_at
          timeline_events << { label: "Work Started", time: @job_card.work_started_at } if @job_card.respond_to?(:work_started_at) && @job_card.work_started_at
          timeline_events << { label: "Work Completed", time: @job_card.work_completed_at } if @job_card.respond_to?(:work_completed_at) && @job_card.work_completed_at
          timeline_events << { label: "Gate Pass Issued", time: @job_card.gate_pass_issued_at } if @job_card.respond_to?(:gate_pass_issued_at) && @job_card.gate_pass_issued_at
        %>
        <% if timeline_events.any? %>
          <% timeline_events.each_with_index do |event, idx| %>
            <div class="flex items-start gap-3">
              <div class="flex flex-col items-center">
                <div class="w-3 h-3 rounded-full bg-indigo-600 border-2 border-indigo-200"></div>
                <% unless idx == timeline_events.size - 1 %>
                  <div class="w-0.5 h-6 bg-indigo-200"></div>
                <% end %>
              </div>
              <div class="pb-3">
                <p class="text-xs font-medium text-gray-900"><%= event[:label] %></p>
                <p class="text-[11px] text-gray-500"><%= event[:time]&.strftime("%d %b %Y, %I:%M %p") %></p>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-gray-500 text-center py-4">No timeline events recorded yet.</p>
        <% end %>

        <% if @job_card.turnaround_hours %>
          <div class="rounded-lg bg-indigo-50 border border-indigo-200 p-3 mt-2">
            <p class="text-xs font-medium text-indigo-700">Total Turnaround: <%= @job_card.turnaround_hours %> hours</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Inspection Summary -->
    <% if @inspection %>
      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Inspection Summary</h3>
          <%= link_to job_card_inspection_path(@job_card, @inspection), class: "text-xs text-indigo-600 hover:text-indigo-500 transition" do %>
            View Full Inspection
          <% end %>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <p class="text-xs text-gray-600">Inspection completed on <%= @inspection.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
        </div>
      </div>
    <% else %>
      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Inspection</h3>
        </div>
        <div class="text-center py-4">
          <p class="text-xs text-gray-500 mb-2">No inspection recorded yet.</p>
          <%= link_to "Start Inspection", new_job_card_inspection_path(@job_card), class: "inline-block text-xs text-indigo-600 hover:text-indigo-500 transition" %>
        </div>
      </div>
    <% end %>

    <!-- Estimates -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900">Estimates</h3>
        <%= link_to new_job_card_estimate_path(@job_card), class: "text-xs text-indigo-600 hover:text-indigo-500 transition" do %>
          + New Estimate
        <% end %>
      </div>
      <% if @estimates.any? %>
        <div class="space-y-3">
          <% @estimates.each do |estimate| %>
            <%= link_to job_card_estimate_path(@job_card, estimate), class: "block rounded-lg bg-gray-50 p-3 hover:bg-gray-100 transition" do %>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-medium text-gray-900">Estimate #<%= estimate.id %></p>
                  <p class="text-[11px] text-gray-500 mt-0.5"><%= estimate.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
                </div>
                <% if estimate.respond_to?(:total_amount) && estimate.total_amount %>
                  <span class="text-xs font-medium text-gray-900"><%= number_to_currency(estimate.total_amount, unit: "\u20B9", precision: 2) %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <% if @estimates.any? && !@job_card.estimate_sent? %>
          <div class="mt-4">
            <%= link_to send_estimate_job_card_path(@job_card), data: { turbo_method: :post, turbo_confirm: "Send the latest estimate to the customer?" }, class: "inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-xs font-medium text-white hover:bg-green-500 transition" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>
              Send Estimate to Customer
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No estimates created yet.</p>
      <% end %>
    </div>

    <!-- Invoices -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900">Invoices</h3>
        <% if @job_card.completed? || @job_card.invoiced? %>
          <%= link_to generate_invoice_job_card_path(@job_card), data: { turbo_method: :post, turbo_confirm: "Generate invoice from estimates?" }, class: "text-xs text-indigo-600 hover:text-indigo-500 transition" do %>
            + Generate Invoice
          <% end %>
        <% end %>
      </div>
      <% if @invoices.any? %>
        <div class="space-y-3">
          <% @invoices.each do |invoice| %>
            <%= link_to invoice_path(invoice), class: "block rounded-lg bg-gray-50 p-3 hover:bg-gray-100 transition" do %>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-medium text-gray-900">Invoice #<%= invoice.respond_to?(:invoice_number) ? invoice.invoice_number : invoice.id %></p>
                  <p class="text-[11px] text-gray-500 mt-0.5"><%= invoice.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
                </div>
                <div class="text-right">
                  <% if invoice.respond_to?(:total_amount) && invoice.total_amount %>
                    <span class="text-xs font-medium text-gray-900"><%= number_to_currency(invoice.total_amount, unit: "\u20B9", precision: 2) %></span>
                  <% end %>
                  <% if invoice.respond_to?(:status) %>
                    <div class="mt-0.5"><%= status_badge(invoice.status) %></div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No invoices generated yet.</p>
      <% end %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Technician Assignments -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Technician Assignments</h3>
      <% if @assignments.any? %>
        <div class="space-y-3">
          <% @assignments.each do |assignment| %>
            <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3">
              <div>
                <p class="text-xs font-medium text-gray-900"><%= assignment.technician.name %></p>
                <p class="text-[11px] text-gray-500"><%= assignment.created_at.strftime("%d %b %Y") %></p>
              </div>
              <%= link_to job_card_technician_assignment_path(@job_card, assignment), data: { turbo_method: :delete, turbo_confirm: "Remove this technician?" }, class: "text-gray-400 hover:text-red-500 transition", title: "Remove" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-2">No technicians assigned yet.</p>
      <% end %>

      <!-- Add Technician Form -->
      <div class="mt-4 border-t border-gray-200 pt-4">
        <p class="text-[11px] text-gray-500 mb-2">Add Technician</p>
        <%= form_with url: job_card_technician_assignments_path(@job_card), method: :post, class: "flex items-center gap-2" do |f| %>
          <%= f.select :technician_id, Technician.all.map { |t| [t.name, t.id] }, { prompt: "Select technician" }, class: "flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
          <%= f.submit "Add", class: "rounded-lg bg-indigo-600 px-3 py-2 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <!-- Gate Pass -->
    <% if @job_card.paid? || @job_card.invoiced? %>
      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Gate Pass</h3>
        <% if @job_card.gate_pass_issued? %>
          <div class="rounded-lg bg-green-50 border border-green-200 p-3">
            <p class="text-xs font-medium text-green-700">Gate pass issued</p>
            <% if @job_card.respond_to?(:gate_pass_issued_at) && @job_card.gate_pass_issued_at %>
              <p class="text-[11px] text-green-600 mt-1"><%= @job_card.gate_pass_issued_at.strftime("%d %b %Y, %I:%M %p") %></p>
            <% end %>
          </div>
        <% else %>
          <%= link_to issue_gate_pass_job_card_path(@job_card), data: { turbo_method: :post, turbo_confirm: "Issue gate pass for this vehicle?" }, class: "w-full inline-flex items-center justify-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-teal-500 transition" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Issue Gate Pass
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Comments -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Comments</h3>

      <!-- Add Comment Form -->
      <%= form_with(model: [@job_card, @comment], class: "mb-4") do |f| %>
        <%= f.text_area :body, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Add a comment..." %>
        <%= f.submit "Add Comment", class: "mt-2 w-full rounded-lg bg-indigo-600 px-4 py-2 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
      <% end %>

      <!-- Comments List -->
      <div class="space-y-3 max-h-96 overflow-y-auto">
        <% @comments.each do |comment| %>
          <div class="rounded-lg bg-gray-50 p-3">
            <p class="text-xs text-gray-900"><%= comment.body %></p>
            <div class="mt-2 flex items-center gap-2 text-[11px] text-gray-500">
              <span class="font-medium text-indigo-600"><%= comment.user.name %></span>
              <span>&middot;</span>
              <span><%= comment.created_at.strftime("%d %b %Y, %I:%M %p") %></span>
            </div>
          </div>
        <% end %>
        <% if @comments.empty? %>
          <p class="text-xs text-gray-500 text-center py-4">No comments yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
