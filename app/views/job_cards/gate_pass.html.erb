<% content_for :page_title, "Gate Pass #{@job_card.gate_pass_number}" %>

<style>
  @media print {
    body * { visibility: hidden; }
    #gate-pass-card, #gate-pass-card * { visibility: visible; }
    #gate-pass-card { position: absolute; top: 0; left: 0; width: 100%; }
    .no-print { display: none !important; }
    @page { margin: 10mm; size: auto; }
  }
</style>

<!-- Action bar (hidden on print) -->
<div class="mb-6 flex items-center justify-between no-print">
  <div class="flex items-center gap-3">
    <%= link_to job_card_path(@job_card), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
      Back to Job Card
    <% end %>
  </div>
  <button onclick="window.print()" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" /></svg>
    Print Gate Pass
  </button>
</div>

<!-- Gate Pass Card -->
<div id="gate-pass-card" class="mx-auto max-w-lg">
  <div class="rounded-xl border-2 border-gray-800 bg-white overflow-hidden">

    <!-- Header -->
    <div class="bg-gray-900 px-6 py-4 text-center">
      <h1 class="text-lg font-bold text-white tracking-wide">GATE PASS</h1>
      <p class="text-sm font-semibold text-gray-300 mt-1"><%= @job_card.gate_pass_number %></p>
    </div>

    <!-- Branch Info -->
    <div class="border-b border-gray-300 px-6 py-3 text-center bg-gray-50">
      <p class="text-sm font-semibold text-gray-900"><%= @job_card.branch.name %></p>
      <% if @job_card.branch.address.present? %>
        <p class="text-xs text-gray-600 mt-0.5"><%= @job_card.branch.address %></p>
      <% end %>
      <% if @job_card.branch.phone.present? %>
        <p class="text-xs text-gray-600">Ph: <%= @job_card.branch.phone %></p>
      <% end %>
      <% if @job_card.branch.gst_number.present? %>
        <p class="text-[11px] text-gray-500 mt-0.5">GSTIN: <%= @job_card.branch.gst_number %></p>
      <% end %>
    </div>

    <div class="px-6 py-4 space-y-4">

      <!-- Vehicle Details -->
      <div>
        <h3 class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Vehicle</h3>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <div>
            <p class="text-[10px] text-gray-500">Registration No.</p>
            <p class="text-sm font-bold text-gray-900"><%= @job_card.vehicle.registration_number %></p>
          </div>
          <div>
            <p class="text-[10px] text-gray-500">Make / Model</p>
            <p class="text-xs font-medium text-gray-900"><%= @job_card.vehicle.make %> <%= @job_card.vehicle.model %></p>
          </div>
          <% if @job_card.vehicle.color.present? %>
            <div>
              <p class="text-[10px] text-gray-500">Color</p>
              <p class="text-xs text-gray-900"><%= @job_card.vehicle.color %></p>
            </div>
          <% end %>
          <% if @job_card.odometer_reading %>
            <div>
              <p class="text-[10px] text-gray-500">Odometer</p>
              <p class="text-xs text-gray-900"><%= number_with_delimiter(@job_card.odometer_reading) %> km</p>
            </div>
          <% end %>
        </div>
      </div>

      <hr class="border-gray-200">

      <!-- Customer Details -->
      <div>
        <h3 class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Customer</h3>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <div>
            <p class="text-[10px] text-gray-500">Name</p>
            <p class="text-xs font-medium text-gray-900"><%= @job_card.customer.name %></p>
          </div>
          <div>
            <p class="text-[10px] text-gray-500">Phone</p>
            <p class="text-xs text-gray-900"><%= @job_card.customer.phone %></p>
          </div>
        </div>
      </div>

      <hr class="border-gray-200">

      <!-- Job Card & Service -->
      <div>
        <h3 class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Service Details</h3>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <div>
            <p class="text-[10px] text-gray-500">Job Card</p>
            <p class="text-xs font-medium text-gray-900"><%= @job_card.job_card_number %></p>
          </div>
          <div>
            <p class="text-[10px] text-gray-500">Service Type</p>
            <p class="text-xs text-gray-900"><%= @job_card.service_type&.name || "General Service" %></p>
          </div>
        </div>
      </div>

      <!-- Technicians -->
      <% if @assignments.any? %>
        <div>
          <p class="text-[10px] text-gray-500">Technician(s)</p>
          <p class="text-xs text-gray-900"><%= @assignments.map { |a| a.technician.name }.join(", ") %></p>
        </div>
      <% end %>

      <!-- Customer Complaints -->
      <% if @job_card.customer_complaints.present? %>
        <div>
          <p class="text-[10px] text-gray-500">Complaints / Work Done</p>
          <p class="text-xs text-gray-900 whitespace-pre-line"><%= @job_card.customer_complaints %></p>
        </div>
      <% end %>

      <hr class="border-gray-200">

      <!-- Amount -->
      <% if @invoice %>
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-3">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-[10px] text-gray-500">Invoice Total</p>
              <p class="text-base font-bold text-gray-900"><%= number_to_currency(@invoice.grand_total, unit: "\u20B9", precision: 2) %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] text-gray-500">Amount Paid</p>
              <p class="text-base font-bold text-green-700"><%= number_to_currency(@amount_paid, unit: "\u20B9", precision: 2) %></p>
            </div>
          </div>
          <% balance = @invoice.grand_total - @amount_paid %>
          <% if balance > 0 %>
            <div class="mt-2 pt-2 border-t border-gray-200 flex items-center justify-between">
              <p class="text-[10px] text-gray-500">Balance Due</p>
              <p class="text-sm font-semibold text-red-600"><%= number_to_currency(balance, unit: "\u20B9", precision: 2) %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <hr class="border-gray-200">

      <!-- Timestamps -->
      <div>
        <h3 class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Timeline</h3>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <% if @job_card.checked_in_at %>
            <div>
              <p class="text-[10px] text-gray-500">Checked In</p>
              <p class="text-[11px] text-gray-900"><%= @job_card.checked_in_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
          <% if @job_card.work_completed_at %>
            <div>
              <p class="text-[10px] text-gray-500">Work Completed</p>
              <p class="text-[11px] text-gray-900"><%= @job_card.work_completed_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
          <% if @job_card.gate_pass_issued_at %>
            <div>
              <p class="text-[10px] text-gray-500">Gate Pass Issued</p>
              <p class="text-[11px] font-medium text-gray-900"><%= @job_card.gate_pass_issued_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
          <% if @job_card.gate_pass_issued_by %>
            <div>
              <p class="text-[10px] text-gray-500">Issued By</p>
              <p class="text-[11px] text-gray-900"><%= @job_card.gate_pass_issued_by.name %></p>
            </div>
          <% end %>
        </div>
        <% if @job_card.turnaround_hours %>
          <div class="mt-2 rounded bg-indigo-50 px-2 py-1 inline-block">
            <p class="text-[11px] font-medium text-indigo-700">Turnaround: <%= @job_card.turnaround_hours %> hrs</p>
          </div>
        <% end %>
      </div>

      <!-- Signature lines -->
      <div class="grid grid-cols-2 gap-8 mt-6 pt-4">
        <div class="text-center">
          <div class="border-b border-gray-400 mb-1 h-8"></div>
          <p class="text-[10px] text-gray-500">Customer Signature</p>
        </div>
        <div class="text-center">
          <div class="border-b border-gray-400 mb-1 h-8"></div>
          <p class="text-[10px] text-gray-500">Authorized Signature</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="border-t border-gray-300 bg-gray-50 px-6 py-2 text-center">
      <p class="text-[10px] text-gray-500">Kuposu Bus Management &mdash; Thank you for your business</p>
    </div>
  </div>
</div>
