<% content_for :page_title, "Payments" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Payments</h2>
    <p class="text-xs text-gray-500 mt-1"><%= @pagy.count %> total payments</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_tag payments_path, method: :get, class: "flex items-center gap-2" do %>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <%= text_field_tag :search, params[:search], placeholder: "Search by customer...", class: "w-56 rounded-lg border border-gray-300 bg-white pl-10 pr-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      </div>
      <%= submit_tag "Search", class: "rounded-lg bg-gray-100 border border-gray-300 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition cursor-pointer" %>
      <% if params[:search].present? %>
        <%= link_to "Clear", payments_path, class: "text-xs text-gray-500 hover:text-gray-900 transition" %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Received By</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @payments.each do |payment| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs text-gray-500"><%= payment.paid_at.strftime("%d %b %Y, %I:%M %p") %></td>
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= payment.customer&.name %></td>
            <td class="px-4 py-3 text-xs">
              <%= link_to payment.invoice&.invoice_number, invoice_path(payment.invoice), class: "text-indigo-600 hover:text-indigo-500" %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= number_to_currency(payment.amount, unit: "\u20B9") %></td>
            <td class="px-4 py-3">
              <% method_colors = { "cash" => "bg-green-100 text-green-800", "upi" => "bg-blue-100 text-blue-800", "card" => "bg-purple-100 text-purple-800", "bank_transfer" => "bg-indigo-100 text-indigo-800", "cheque" => "bg-yellow-100 text-yellow-800" } %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= method_colors[payment.payment_method] || 'bg-gray-100 text-gray-800' %>">
                <%= payment.payment_method&.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= payment.received_by&.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @payments.empty? %>
    <div class="text-center py-12">
      <p class="mt-3 text-xs text-gray-500">No payments found.</p>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500">Showing <%= @pagy.from %> to <%= @pagy.to %> of <%= @pagy.count %> results</p>
      <nav class="flex items-center gap-1">
        <% if @pagy.prev %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.prev)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Prev<% end %>
        <% end %>
        <% @pagy.series.each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "rounded-lg px-3 py-1.5 text-xs #{item == @pagy.page ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" %>
          <% elsif item.is_a?(String) %>
            <span class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs text-white"><%= item %></span>
          <% elsif item == :gap %>
            <span class="px-2 text-gray-500">...</span>
          <% end %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.next)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Next<% end %>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>
