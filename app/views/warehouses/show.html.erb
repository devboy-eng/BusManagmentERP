<% content_for :page_title, "Warehouse Details" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @warehouse.name %></h2>
    <p class="text-xs text-gray-500 mt-1">Warehouse details and stock entries</p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to edit_warehouse_path(@warehouse), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      Edit
    <% end %>
    <%= link_to warehouses_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to List
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-1">
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Warehouse Information</h3>
      <dl class="space-y-4">
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Name</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @warehouse.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Branch</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @warehouse.branch&.name || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Contact Phone</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @warehouse.contact_phone || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Address</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @warehouse.address || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Status</dt>
          <dd class="mt-1">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= @warehouse.active? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
              <%= @warehouse.active? ? "Active" : "Inactive" %>
            </span>
            <% if @warehouse.is_default? %>
              <span class="ml-1 inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-medium text-indigo-700">Default</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="lg:col-span-2">
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Stock Entries</h3>
      <% if @stock_entries.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50">
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Part</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @stock_entries.each do |entry| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2 text-xs text-gray-900"><%= entry.spare_part&.name %></td>
                  <td class="px-4 py-2 text-xs text-gray-600"><%= entry.quantity %></td>
                  <td class="px-4 py-2 text-xs text-gray-500"><%= entry.created_at.strftime("%d %b %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No stock entries yet.</p>
      <% end %>
    </div>
  </div>
</div>
