<%= form_with(model: warehouse, class: "space-y-6") do |f| %>
  <% if warehouse.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-xs font-medium text-red-700"><%= pluralize(warehouse.errors.count, "error") %> prevented this warehouse from being saved:</p>
      <ul class="mt-2 list-disc list-inside text-xs text-red-600">
        <% warehouse.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Name *</label>
      <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter warehouse name" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Contact Phone</label>
      <%= f.text_field :contact_phone, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter contact phone" %>
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Branch</label>
      <%= f.collection_select :branch_id, @branches, :id, :name, { include_blank: "Select branch" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1.5">Address</label>
    <%= f.text_area :address, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter address" %>
  </div>

  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 text-xs text-gray-600">
      <%= f.check_box :is_default, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      Default Warehouse
    </label>
    <label class="flex items-center gap-2 text-xs text-gray-600">
      <%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      Active
    </label>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", warehouses_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
  </div>
<% end %>
