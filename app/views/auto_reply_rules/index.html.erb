<% content_for :page_title, "Auto-Reply Rules" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Auto-Reply Rules</h2>
    <p class="text-xs text-gray-500 mt-1">Automatic responses triggered by keywords or conditions</p>
  </div>
  <div class="flex items-center gap-2">
    <%= render "shared/guide_button", section: "auto_reply" %>
    <%= link_to new_auto_reply_rule_path, class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      New Rule
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <% if @rules.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Name</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Trigger</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Keyword</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Reply</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-right text-[11px] font-semibold text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rules.each do |rule| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs font-medium text-gray-900"><%= rule.name %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium
                <%= case rule.trigger_type
                    when 'keyword' then 'bg-blue-50 text-blue-700 border-blue-200'
                    when 'first_message' then 'bg-purple-50 text-purple-700 border-purple-200'
                    when 'outside_hours' then 'bg-orange-50 text-orange-700 border-orange-200'
                    end %>">
                <%= rule.trigger_type.titleize %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= rule.keyword.presence || "--" %></td>
            <td class="px-4 py-3 text-xs text-gray-500 max-w-xs truncate"><%= truncate(rule.reply_body, length: 50) %></td>
            <td class="px-4 py-3">
              <% if rule.active? %>
                <span class="inline-flex items-center rounded-full bg-green-50 border border-green-200 px-2 py-0.5 text-[11px] font-medium text-green-700">Active</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-50 border border-gray-200 px-2 py-0.5 text-[11px] font-medium text-gray-500">Inactive</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-1">
                <%= link_to toggle_auto_reply_rule_path(rule), data: { turbo_method: :patch }, class: "h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition", title: rule.active? ? "Deactivate" : "Activate" do %>
                  <% if rule.active? %>
                    <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9" /></svg>
                  <% else %>
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9" /></svg>
                  <% end %>
                <% end %>
                <%= link_to edit_auto_reply_rule_path(rule), class: "h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition", title: "Edit" do %>
                  <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                <% end %>
                <%= link_to auto_reply_rule_path(rule), data: { turbo_method: :delete, turbo_confirm: "Delete this rule?" }, class: "h-8 w-8 rounded-full hover:bg-red-50 flex items-center justify-center transition", title: "Delete" do %>
                  <svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-xs text-gray-500">No auto-reply rules yet.</p>
      <p class="text-xs text-gray-400 mt-1"><%= link_to "Create one", new_auto_reply_rule_path, class: "text-indigo-600 hover:text-indigo-500" %> to automate responses.</p>
    </div>
  <% end %>
</div>
