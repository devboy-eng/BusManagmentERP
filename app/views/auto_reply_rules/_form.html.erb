<%= form_with(model: rule, class: "space-y-5") do |f| %>
  <% if rule.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-3">
      <p class="text-xs font-medium text-red-700"><%= pluralize(rule.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc pl-4">
        <% rule.errors.full_messages.each do |msg| %>
          <li class="text-[11px] text-red-600"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. Welcome Message" %>
  </div>

  <div>
    <%= f.label :trigger_type, "Trigger Type", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.select :trigger_type, options_for_select(AutoReplyRule::TRIGGER_TYPES.map { |t| [t.titleize, t] }, rule.trigger_type), {}, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
    <p class="text-[11px] text-gray-400 mt-1">
      <strong>Keyword</strong> — triggers when message contains the keyword.
      <strong>First Message</strong> — triggers on first contact.
      <strong>Outside Hours</strong> — triggers outside 9 AM - 6 PM.
    </p>
  </div>

  <div>
    <%= f.label :keyword, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :keyword, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. hello" %>
    <p class="text-[11px] text-gray-400 mt-1">Required for keyword triggers. Case-insensitive match.</p>
  </div>

  <div>
    <%= f.label :reply_body, "Reply Message", class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_area :reply_body, rows: 4, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "Type the automatic reply message..." %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
    <%= f.label :active, "Active", class: "text-xs font-medium text-gray-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", auto_reply_rules_path, class: "text-xs text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
