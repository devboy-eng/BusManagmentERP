<% content_for :page_title, "WhatsApp Marketing" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">WhatsApp Marketing</h2>
    <p class="text-xs text-gray-500 mt-1">Send promotional messages to leads and customers</p>
  </div>
  <%= render "shared/guide_button", section: "marketing" %>
</div>

<!-- Configuration Warning -->
<% unless @configured %>
  <div class="mb-6 rounded-xl border border-yellow-200 bg-yellow-50 p-4 flex items-center gap-3">
    <svg class="h-5 w-5 text-yellow-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
    <div>
      <p class="text-xs font-medium text-yellow-800">WhatsApp API not configured</p>
      <p class="text-[11px] text-yellow-600 mt-0.5">Messages won't be delivered until you configure your API credentials. <%= link_to "Configure now", edit_whatsapp_setting_path, class: "underline font-medium" %></p>
    </div>
  </div>
<% end %>

<!-- Stats -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Total Leads</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_leads %></p>
      </div>
      <div class="h-12 w-12 rounded-xl bg-blue-50 flex items-center justify-center">
        <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Active Customers</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_customers %></p>
      </div>
      <div class="h-12 w-12 rounded-xl bg-green-50 flex items-center justify-center">
        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Total Reachable</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_leads + @total_customers %></p>
      </div>
      <div class="h-12 w-12 rounded-xl bg-indigo-50 flex items-center justify-center">
        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      </div>
    </div>
  </div>
</div>

<!-- Actions -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <!-- Send to Leads -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-10 w-10 rounded-xl bg-green-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Send to Leads</h3>
        <p class="text-xs text-gray-500">Send promotional WhatsApp messages to leads</p>
      </div>
    </div>
    <div class="space-y-3">
      <%= link_to compose_whatsapp_marketing_index_path(type: "leads"), class: "flex items-center justify-between rounded-lg bg-gray-50 p-3 hover:bg-gray-100 transition" do %>
        <span class="text-xs text-gray-900">Custom Message</span>
        <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      <% end %>
      <%= form_tag send_bulk_whatsapp_marketing_index_path, method: :post, class: "mt-3" do %>
        <%= hidden_field_tag :type, "leads" %>
        <%= text_area_tag :message, nil, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Type bulk message for all leads..." %>
        <%= submit_tag "Send Bulk to All Leads", class: "mt-2 w-full rounded-lg bg-green-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Send to Customers -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-10 w-10 rounded-xl bg-indigo-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Send to Customers</h3>
        <p class="text-xs text-gray-500">Send promotional WhatsApp messages to customers</p>
      </div>
    </div>
    <div class="space-y-3">
      <%= link_to compose_whatsapp_marketing_index_path(type: "customers"), class: "flex items-center justify-between rounded-lg bg-gray-50 p-3 hover:bg-gray-100 transition" do %>
        <span class="text-xs text-gray-900">Custom Message</span>
        <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      <% end %>
      <%= form_tag send_bulk_whatsapp_marketing_index_path, method: :post, class: "mt-3" do %>
        <%= hidden_field_tag :type, "customers" %>
        <%= text_area_tag :message, nil, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Type bulk message for all customers..." %>
        <%= submit_tag "Send Bulk to All Customers", class: "mt-2 w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Recent Messages & Upcoming Follow-ups -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <!-- Recent Messages -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-gray-900">Recent Messages</h3>
      <%= link_to "View All", message_log_whatsapp_marketing_index_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
    <% if @recent_messages.any? %>
      <div class="space-y-3">
        <% @recent_messages.each do |msg| %>
          <div class="rounded-lg bg-gray-50 p-3">
            <div class="flex items-center justify-between mb-1">
              <p class="text-xs font-medium text-gray-900"><%= msg.recipient_name %></p>
              <%= whatsapp_status_badge(msg.status) %>
            </div>
            <p class="text-[11px] text-gray-500 truncate"><%= truncate(msg.message_body, length: 60) %></p>
            <p class="text-[11px] text-gray-400 mt-1"><%= msg.created_at.strftime("%d %b, %I:%M %p") %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 text-center py-4">No messages sent yet.</p>
    <% end %>
  </div>

  <!-- Upcoming Follow-ups -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-gray-900">Upcoming Follow-ups</h3>
      <%= link_to "View All", follow_ups_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
    <% if @upcoming_follow_ups.any? %>
      <div class="space-y-3">
        <% @upcoming_follow_ups.each do |fu| %>
          <div class="rounded-lg bg-gray-50 p-3">
            <div class="flex items-center justify-between mb-1">
              <p class="text-xs font-medium text-gray-900"><%= fu.lead.name %></p>
              <%= follow_up_status_badge(fu.status) %>
            </div>
            <p class="text-[11px] text-gray-500 truncate"><%= truncate(fu.message, length: 60) %></p>
            <p class="text-[11px] text-gray-400 mt-1">Scheduled: <%= fu.scheduled_at.strftime("%d %b, %I:%M %p") %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 text-center py-4">No upcoming follow-ups.</p>
    <% end %>
  </div>
</div>
