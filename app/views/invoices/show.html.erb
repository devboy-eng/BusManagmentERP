<% content_for :page_title, "Invoice #{@invoice.invoice_number}" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @invoice.invoice_number %></h2>
    <p class="text-xs text-gray-500 mt-1">Job Card: <%= @invoice.job_card&.job_card_number %> | Customer: <%= @invoice.customer&.name %></p>
  </div>
  <div class="flex items-center gap-3">
    <% if @invoice.balance_due > 0 %>
      <%= link_to new_payment_path(invoice_id: @invoice.id), class: "inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition" do %>
        Record Payment
      <% end %>
    <% end %>
    <%= link_to edit_invoice_path(@invoice), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Edit
    <% end %>
    <%= link_to invoice_path(@invoice, format: :pdf), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Download PDF
    <% end %>
    <%= link_to invoices_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to List
    <% end %>
  </div>
</div>

<div class="space-y-6">
  <!-- Invoice Details -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Invoice Details</h3>
    <dl class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Invoice Number</dt>
        <dd class="text-xs text-gray-900 mt-1"><%= @invoice.invoice_number %></dd>
      </div>
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Customer</dt>
        <dd class="text-xs text-gray-900 mt-1"><%= @invoice.customer&.name %></dd>
      </div>
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Status</dt>
        <dd class="mt-1">
          <% inv_colors = { "draft" => "bg-gray-100 text-gray-800", "sent" => "bg-blue-100 text-blue-800", "partially_paid" => "bg-yellow-100 text-yellow-800", "paid" => "bg-green-100 text-green-800", "cancelled" => "bg-red-100 text-red-800" } %>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= inv_colors[@invoice.status] || 'bg-gray-100 text-gray-800' %>">
            <%= @invoice.status.humanize %>
          </span>
        </dd>
      </div>
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Balance Due</dt>
        <dd class="text-xs mt-1 font-medium <%= @invoice.balance_due > 0 ? 'text-red-600' : 'text-green-600' %>">
          <%= number_to_currency(@invoice.balance_due, unit: "\u20B9") %>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Line Items -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Line Items</h3>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Qty</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Unit Price</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @invoice.line_items.each do |item| %>
            <tr>
              <td class="px-4 py-2">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= item.item_type == 'labor' ? 'bg-blue-100 text-blue-800' : 'bg-yellow-100 text-yellow-800' %>">
                  <%= item.item_type&.capitalize %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs text-gray-900"><%= item.description %></td>
              <td class="px-4 py-2 text-xs text-gray-600"><%= item.quantity %></td>
              <td class="px-4 py-2 text-xs text-gray-600"><%= number_to_currency(item.unit_price, unit: "\u20B9") %></td>
              <td class="px-4 py-2 text-xs text-gray-900 font-medium"><%= number_to_currency(item.total_price, unit: "\u20B9") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Tax Breakdown -->
    <div class="max-w-sm ml-auto mt-4 space-y-2">
      <div class="flex justify-between text-xs">
        <span class="text-gray-500">Subtotal</span>
        <span class="text-gray-900"><%= number_to_currency(@invoice.subtotal, unit: "\u20B9") %></span>
      </div>
      <% if @invoice.respond_to?(:discount_amount) && @invoice.discount_amount.present? && @invoice.discount_amount > 0 %>
        <div class="flex justify-between text-xs">
          <span class="text-gray-500">Discount</span>
          <span class="text-red-600">-<%= number_to_currency(@invoice.discount_amount, unit: "\u20B9") %></span>
        </div>
      <% end %>
      <% if @invoice.respond_to?(:cgst_amount) && @invoice.cgst_amount.present? && @invoice.cgst_amount > 0 %>
        <div class="flex justify-between text-xs">
          <span class="text-gray-500">CGST</span>
          <span class="text-gray-900"><%= number_to_currency(@invoice.cgst_amount, unit: "\u20B9") %></span>
        </div>
      <% end %>
      <% if @invoice.respond_to?(:sgst_amount) && @invoice.sgst_amount.present? && @invoice.sgst_amount > 0 %>
        <div class="flex justify-between text-xs">
          <span class="text-gray-500">SGST</span>
          <span class="text-gray-900"><%= number_to_currency(@invoice.sgst_amount, unit: "\u20B9") %></span>
        </div>
      <% end %>
      <% if @invoice.respond_to?(:igst_amount) && @invoice.igst_amount.present? && @invoice.igst_amount > 0 %>
        <div class="flex justify-between text-xs">
          <span class="text-gray-500">IGST</span>
          <span class="text-gray-900"><%= number_to_currency(@invoice.igst_amount, unit: "\u20B9") %></span>
        </div>
      <% end %>
      <div class="flex justify-between text-sm font-bold border-t border-gray-300 pt-2">
        <span class="text-gray-900">Grand Total</span>
        <span class="text-gray-900"><%= number_to_currency(@invoice.grand_total, unit: "\u20B9") %></span>
      </div>
    </div>
  </div>

  <!-- Payment History -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Payment History</h3>
    <% if @invoice.payments.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50">
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Method</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Reference</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Received By</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @invoice.payments.order(paid_at: :desc).each do |payment| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2 text-xs text-gray-600"><%= payment.paid_at.strftime("%d %b %Y, %I:%M %p") %></td>
                <td class="px-4 py-2 text-xs text-gray-900 font-medium"><%= number_to_currency(payment.amount, unit: "\u20B9") %></td>
                <td class="px-4 py-2 text-xs text-gray-600"><%= payment.payment_method&.humanize %></td>
                <td class="px-4 py-2 text-xs text-gray-600"><%= payment.transaction_reference || "-" %></td>
                <td class="px-4 py-2 text-xs text-gray-600"><%= payment.received_by&.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 text-center py-4">No payments recorded yet.</p>
    <% end %>
  </div>
</div>
