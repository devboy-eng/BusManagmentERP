<% content_for :page_title, "Edit Invoice" %>

<div class="max-w-3xl">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900">Edit Invoice</h2>
    <p class="text-xs text-gray-500 mt-1"><%= @invoice.invoice_number %></p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <%= form_with(model: @invoice, class: "space-y-6") do |f| %>
      <% if @invoice.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-4">
          <p class="text-xs font-medium text-red-700"><%= pluralize(@invoice.errors.count, "error") %> prevented this invoice from being saved:</p>
          <ul class="mt-2 list-disc list-inside text-xs text-red-600">
            <% @invoice.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Status</label>
        <%= f.select :status, Invoice.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Notes</label>
        <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Additional notes" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
        <%= link_to "Cancel", invoice_path(@invoice), class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
      </div>
    <% end %>
  </div>
</div>
