<div class="rounded-xl border border-gray-200 bg-white p-6">
  <h2 class="text-lg font-semibold text-gray-900 text-center mb-2">Estimate Approval</h2>
  <p class="text-xs text-gray-500 text-center mb-6">Please review the estimate below and approve or reject.</p>

  <div class="space-y-4 mb-6">
    <div class="rounded-lg bg-gray-50 p-3">
      <dt class="text-[11px] text-gray-500">Job Card</dt>
      <dd class="text-xs text-gray-900 mt-1"><%= @job_card.job_card_number %></dd>
    </div>
    <div class="rounded-lg bg-gray-50 p-3">
      <dt class="text-[11px] text-gray-500">Vehicle</dt>
      <dd class="text-xs text-gray-900 mt-1"><%= @job_card.vehicle&.display_name %></dd>
    </div>
    <div class="rounded-lg bg-gray-50 p-3">
      <dt class="text-[11px] text-gray-500">Customer</dt>
      <dd class="text-xs text-gray-900 mt-1"><%= @job_card.customer&.name %></dd>
    </div>
  </div>

  <% if @estimate %>
    <div class="rounded-lg border border-gray-200 p-4 mb-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Estimate: <%= @estimate.estimate_number %></h3>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Description</th>
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Qty</th>
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Price</th>
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @estimate.line_items.each do |item| %>
              <tr>
                <td class="px-3 py-2 text-xs text-gray-900"><%= item.description %></td>
                <td class="px-3 py-2 text-xs text-gray-600"><%= item.quantity %></td>
                <td class="px-3 py-2 text-xs text-gray-600"><%= number_to_currency(item.unit_price, unit: "\u20B9") %></td>
                <td class="px-3 py-2 text-xs text-gray-900"><%= number_to_currency(item.total_price, unit: "\u20B9") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3 pt-3 border-t border-gray-200 text-right">
        <p class="text-sm font-bold text-gray-900">Grand Total: <%= number_to_currency(@estimate.grand_total, unit: "\u20B9") %></p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= form_tag customer_approval_path(params[:token]), method: :post, class: "flex-1" do %>
        <%= submit_tag "Approve Estimate", class: "w-full rounded-lg bg-green-600 px-6 py-3 text-sm font-medium text-white hover:bg-green-500 transition cursor-pointer" %>
      <% end %>
      <%= form_tag customer_rejection_path(params[:token]), method: :post, class: "flex-1" do %>
        <%= submit_tag "Reject Estimate", class: "w-full rounded-lg bg-red-600 px-6 py-3 text-sm font-medium text-white hover:bg-red-500 transition cursor-pointer" %>
      <% end %>
    </div>
  <% else %>
    <p class="text-xs text-gray-500 text-center py-4">No estimate available for this job card.</p>
  <% end %>
</div>
