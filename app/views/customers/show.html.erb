<% content_for :page_title, "Customer Details" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @customer.name %></h2>
    <p class="text-xs text-gray-500 mt-1">Customer details and vehicles</p>
  </div>
  <div class="flex items-center gap-3">
    <button type="button" onclick="document.getElementById('whatsapp-modal').classList.remove('hidden')" class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      Send WhatsApp
    </button>
    <%= link_to edit_customer_path(@customer), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      Edit
    <% end %>
    <%= link_to customers_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to List
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Customer Info -->
  <div class="lg:col-span-2 space-y-6">
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Customer Information</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Name</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Phone</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.phone %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Email</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.email || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Alternate Phone</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.alternate_phone || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Customer Type</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.customer_type&.titleize || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Company Name</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.company_name || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">GST Number</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.gst_number || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">City</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.city || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">State</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.state || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Status</dt>
          <dd class="mt-1"><%= status_badge(@customer.status, :customer) %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Created</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.created_at.strftime("%d %b %Y, %I:%M %p") %></dd>
        </div>
      </dl>

      <!-- Change Status -->
      <div class="mt-4 rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500 mb-2">Change Status</dt>
        <dd class="flex flex-wrap gap-2">
          <%= link_to "Active", toggle_status_customer_path(@customer, status: :active), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@customer.active? ? 'bg-green-100 text-green-800 border-green-300' : 'bg-white text-green-700 border-green-200 hover:bg-green-50'}" %>
          <%= link_to "Non Active", toggle_status_customer_path(@customer, status: :non_active), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@customer.non_active? ? 'bg-red-100 text-red-800 border-red-300' : 'bg-white text-red-700 border-red-200 hover:bg-red-50'}" %>
        </dd>
      </div>

      <% if @customer.address.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Address</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.address %></dd>
        </div>
      <% end %>

      <% if @customer.notes.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Notes</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @customer.notes %></dd>
        </div>
      <% end %>
    </div>

    <!-- Vehicles Section -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900">Vehicles</h3>
        <%= link_to new_vehicle_path(customer_id: @customer.id), class: "inline-flex items-center gap-1 text-xs text-indigo-600 hover:text-indigo-500" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Add Vehicle
        <% end %>
      </div>
      <% if @customer.vehicles.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50">
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Registration #</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Make / Model</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Year</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @customer.vehicles.each do |vehicle| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2 text-xs font-medium">
                    <%= link_to vehicle.registration_number, vehicle_path(vehicle), class: "text-indigo-600 hover:text-indigo-500" %>
                  </td>
                  <td class="px-4 py-2 text-xs text-gray-600"><%= [vehicle.make, vehicle.model].compact.join(" ") %></td>
                  <td class="px-4 py-2 text-xs text-gray-600"><%= vehicle.year %></td>
                  <td class="px-4 py-2">
                    <div class="flex items-center gap-2">
                      <%= link_to vehicle_path(vehicle), class: "text-gray-500 hover:text-indigo-600 transition", title: "View" do %>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      <% end %>
                      <%= link_to edit_vehicle_path(vehicle), class: "text-gray-500 hover:text-yellow-500 transition", title: "Edit" do %>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No vehicles registered for this customer yet.</p>
      <% end %>
    </div>

    <!-- WhatsApp Messages -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900">Recent WhatsApp Messages</h3>
      </div>
      <% if @whatsapp_messages.any? %>
        <div class="space-y-3">
          <% @whatsapp_messages.each do |msg| %>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="flex items-center justify-between mb-1">
                <p class="text-xs text-gray-500 truncate flex-1"><%= truncate(msg.message_body, length: 80) %></p>
                <%= whatsapp_status_badge(msg.status) %>
              </div>
              <p class="text-[11px] text-gray-400"><%= msg.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No WhatsApp messages sent to this customer yet.</p>
      <% end %>
    </div>
  </div>

  <!-- Comments -->
  <div>
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Comments</h3>

      <!-- Add Comment Form -->
      <%= form_with(model: [@customer, @comment], class: "mb-4") do |f| %>
        <%= f.text_area :body, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Add a comment..." %>
        <%= f.submit "Add Comment", class: "mt-2 w-full rounded-lg bg-indigo-600 px-4 py-2 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
      <% end %>

      <!-- Comments List -->
      <div class="space-y-3 max-h-96 overflow-y-auto">
        <% @comments.each do |comment| %>
          <div class="rounded-lg bg-gray-50 p-3">
            <p class="text-xs text-gray-900"><%= comment.body %></p>
            <div class="mt-2 flex items-center gap-2 text-[11px] text-gray-500">
              <span class="font-medium text-indigo-600"><%= comment.user.name %></span>
              <span>&middot;</span>
              <span><%= comment.created_at.strftime("%d %b %Y, %I:%M %p") %></span>
            </div>
          </div>
        <% end %>
        <% if @comments.empty? %>
          <p class="text-xs text-gray-500 text-center py-4">No comments yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- WhatsApp Quick Send Modal -->
<div id="whatsapp-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500/75" onclick="document.getElementById('whatsapp-modal').classList.add('hidden')"></div>
    <div class="relative rounded-xl bg-white p-6 shadow-xl w-full max-w-md">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Send WhatsApp to <%= @customer.name %></h3>
      <%= form_tag send_quick_whatsapp_marketing_index_path, method: :post do %>
        <%= hidden_field_tag :recipient_type, "Customer" %>
        <%= hidden_field_tag :recipient_id, @customer.id %>
        <%= text_area_tag :message, nil, rows: 4, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Type your message..." %>
        <div class="flex items-center gap-3 mt-4">
          <%= submit_tag "Send", class: "rounded-lg bg-green-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition cursor-pointer" %>
          <button type="button" onclick="document.getElementById('whatsapp-modal').classList.add('hidden')" class="rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
