<!DOCTYPE html>
<html>
<head>
  <title>Bus Service Pro</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-lg mx-auto px-4 py-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-900">Bus Service Pro</h1>
    </div>
    <% if flash[:notice] %>
      <div class="mb-4 rounded-lg bg-green-50 border border-green-200 p-3 text-sm text-green-700"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </div>
</body>
</html>
