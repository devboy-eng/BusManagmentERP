<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kuposu Bus Management - Login</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="h-full bg-gray-100">
  <div class="flex min-h-full items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
      <div class="text-center">
        <div class="mx-auto h-14 w-14 rounded-2xl bg-indigo-600 flex items-center justify-center">
          <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
          </svg>
        </div>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Kuposu Bus Management</h1>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm">
        <% if notice.present? %>
          <div class="mb-4 rounded-lg bg-green-50 border border-green-200 p-3 text-xs text-green-700"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3 text-xs text-red-700"><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </div>
</body>
</html>
