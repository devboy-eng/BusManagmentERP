<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
  <title><%= content_for?(:page_title) ? "#{yield(:page_title)} | Kuposu Bus Management" : "Kuposu Bus Management" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full" data-controller="sidebar">
  <% if user_signed_in? %>
    <!-- Mobile sidebar overlay -->
    <div data-sidebar-target="overlay" class="hidden fixed inset-0 z-40 bg-gray-600/75 lg:hidden" data-action="click->sidebar#close"></div>

    <!-- Sidebar -->
    <aside data-sidebar-target="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-gray-200 transform -translate-x-full lg:translate-x-0 transition-transform duration-200" role="navigation">
      <div class="flex h-full flex-col">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-200">
          <svg class="h-8 w-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.079-.504 1.025-1.122a18.97 18.97 0 00-3.07-8.428m0 0A18.97 18.97 0 0012 3.75c-2.472 0-4.786.684-6.762 1.95m13.524 0l-2.012 3.35M3.375 14.25V6.375c0-.621.504-1.125 1.125-1.125h4.5" />
          </svg>
          <span class="text-base font-bold text-gray-900">Kuposu Bus Management</span>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          <%= link_to dashboard_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-medium #{controller_name == 'dashboard' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            Dashboard
          <% end %>

          <%= link_to customers_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-medium #{controller_name == 'customers' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            Customers
          <% end %>

          <%= link_to vehicles_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-medium #{controller_name == 'vehicles' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.079-.504 1.025-1.122a18.97 18.97 0 00-3.07-8.428" /></svg>
            Vehicles
          <% end %>

          <%= link_to job_cards_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-medium #{controller_name == 'job_cards' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0118 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3l1.5 1.5 3-3.75" /></svg>
            Job Cards
          <% end %>

          <%= link_to technicians_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-medium #{controller_name == 'technicians' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" /></svg>
            Technicians
          <% end %>

          <!-- Inventory dropdown -->
          <div data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center justify-between w-full rounded-lg px-3 py-2 text-xs font-medium <%= %w[spare_parts suppliers warehouses purchase_orders inventory_movements].include?(controller_name) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50' %>">
              <span class="flex items-center gap-3">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                Inventory
              </span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </button>
            <div data-dropdown-target="menu" class="<%= %w[spare_parts suppliers warehouses purchase_orders inventory_movements].include?(controller_name) ? '' : 'hidden' %> ml-7 mt-1 space-y-1">
              <%= link_to "Parts", spare_parts_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'spare_parts' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Suppliers", suppliers_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'suppliers' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Warehouses", warehouses_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'warehouses' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Purchase Orders", purchase_orders_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'purchase_orders' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Stock Movements", inventory_movements_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'inventory_movements' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
            </div>
          </div>

          <!-- Reports dropdown -->
          <div data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center justify-between w-full rounded-lg px-3 py-2 text-xs font-medium <%= controller_name == 'reports' ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50' %>">
              <span class="flex items-center gap-3">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                Reports
              </span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </button>
            <div data-dropdown-target="menu" class="<%= controller_name == 'reports' ? '' : 'hidden' %> ml-7 mt-1 space-y-1">
              <%= link_to "Revenue", reports_revenue_path, class: "block rounded-lg px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50" %>
              <%= link_to "Technician Productivity", reports_technician_productivity_path, class: "block rounded-lg px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50" %>
              <%= link_to "Parts Usage", reports_parts_usage_path, class: "block rounded-lg px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50" %>
              <%= link_to "Vehicle Turnaround", reports_vehicle_turnaround_path, class: "block rounded-lg px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50" %>
              <%= link_to "Inventory Valuation", reports_inventory_valuation_path, class: "block rounded-lg px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50" %>
            </div>
          </div>

          <!-- WhatsApp dropdown -->
          <% whatsapp_controllers = %w[whatsapp_chats whatsapp_marketing whatsapp_settings whatsapp_templates quick_responses auto_reply_rules scheduled_messages whatsapp_menus whatsapp_guide] %>
          <div data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center justify-between w-full rounded-lg px-3 py-2 text-xs font-medium <%= whatsapp_controllers.include?(controller_name) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50' %>">
              <span class="flex items-center gap-3">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
                WhatsApp
              </span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </button>
            <div data-dropdown-target="menu" class="<%= whatsapp_controllers.include?(controller_name) ? '' : 'hidden' %> ml-7 mt-1 space-y-1">
              <%= link_to "Dashboard", whatsapp_marketing_index_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_marketing' && action_name == 'index' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Chat", whatsapp_chats_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_chats' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Message Log", message_log_whatsapp_marketing_index_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_marketing' && action_name == 'message_log' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Templates", whatsapp_templates_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_templates' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Quick Responses", quick_responses_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'quick_responses' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Auto-Reply Rules", auto_reply_rules_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'auto_reply_rules' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Interactive Menus", whatsapp_menus_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_menus' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Scheduled Messages", scheduled_messages_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'scheduled_messages' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Settings", edit_whatsapp_setting_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_settings' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Guide", whatsapp_guide_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'whatsapp_guide' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
            </div>
          </div>

          <!-- Settings dropdown -->
          <div data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center justify-between w-full rounded-lg px-3 py-2 text-xs font-medium <%= %w[users roles service_types branches].include?(controller_name) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50' %>">
              <span class="flex items-center gap-3">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                Settings
              </span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </button>
            <div data-dropdown-target="menu" class="<%= %w[users roles service_types branches].include?(controller_name) ? '' : 'hidden' %> ml-7 mt-1 space-y-1">
              <%= link_to "Users", users_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'users' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Roles", roles_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'roles' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Service Types", service_types_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'service_types' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
              <%= link_to "Branches", branches_path, class: "block rounded-lg px-3 py-1.5 text-xs #{controller_name == 'branches' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:bg-gray-50'}" %>
            </div>
          </div>
        </nav>

        <!-- User info -->
        <div class="border-t border-gray-200 px-4 py-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="h-7 w-7 rounded-full bg-indigo-100 flex items-center justify-center">
                <span class="text-xs font-medium text-indigo-600"><%= current_user.name&.first&.upcase %></span>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-900"><%= current_user.name %></p>
                <p class="text-[10px] text-gray-500"><%= current_user.email %></p>
              </div>
            </div>
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-400 hover:text-red-500 transition" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
            <% end %>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <div class="lg:pl-64">
      <!-- Top bar -->
      <header class="sticky top-0 z-30 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3 lg:px-6">
        <button data-action="click->sidebar#toggle" class="lg:hidden text-gray-500 hover:text-gray-900">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
        <h1 class="text-sm font-semibold text-gray-900"><%= yield(:page_title) || "Dashboard" %></h1>
        <div class="flex items-center gap-3">
          <%= link_to service_reminders_path, class: "text-gray-400 hover:text-gray-600", title: "Service Reminders" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
          <% end %>
        </div>
      </header>

      <!-- Page content -->
      <main class="p-4 lg:p-6">
        <% if flash[:notice] %>
          <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-xs text-green-700"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-xs text-red-700"><%= flash[:alert] %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  <% else %>
    <%= yield %>
  <% end %>
</body>
</html>
