<% content_for :page_title, "Spare Part Details" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @spare_part.name %></h2>
    <p class="text-xs text-gray-500 mt-1"><%= @spare_part.part_number %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to edit_spare_part_path(@spare_part), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      Edit
    <% end %>
    <%= link_to spare_parts_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to List
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Part Information</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Part Number</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.part_number %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Name</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Category</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.category || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Brand</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.brand || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Compatible Makes</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.compatible_makes || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Unit</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.unit || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Selling Price</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= number_to_currency(@spare_part.selling_price, unit: "\u20B9") %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Cost Price</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= number_to_currency(@spare_part.cost_price, unit: "\u20B9") %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Current Stock</dt>
          <dd class="text-xs mt-1">
            <% low = @spare_part.reorder_level.present? && @spare_part.current_stock <= @spare_part.reorder_level %>
            <span class="font-medium <%= low ? 'text-red-600' : 'text-gray-900' %>"><%= @spare_part.current_stock %></span>
            <% if low %>
              <span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-medium text-red-700">Low Stock</span>
            <% end %>
          </dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Reorder Level</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.reorder_level || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">HSN Code</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.hsn_code || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Warranty (Months)</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.warranty_months || "-" %></dd>
        </div>
      </dl>
      <% if @spare_part.description.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Description</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @spare_part.description %></dd>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Stock Movements</h3>
      <% movements = @spare_part.inventory_movements.includes(:warehouse, :performed_by).order(created_at: :desc).limit(15) %>
      <% if movements.any? %>
        <div class="space-y-3">
          <% movements.each do |m| %>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium <%= m.purchase_in? || m.return_in? ? 'text-green-700' : 'text-red-700' %>">
                  <%= m.movement_type.humanize %> (<%= m.purchase_in? || m.return_in? ? "+" : "-" %><%= m.quantity %>)
                </span>
              </div>
              <p class="text-[11px] text-gray-500 mt-1"><%= m.warehouse&.name %></p>
              <p class="text-[11px] text-gray-400 mt-0.5"><%= m.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No stock movements yet.</p>
      <% end %>
    </div>
  </div>
</div>
