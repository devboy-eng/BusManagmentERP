<% content_for :page_title, "New Estimate" %>

<div class="max-w-4xl">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900">New Estimate</h2>
    <p class="text-xs text-gray-500 mt-1">Job Card: <%= @job_card.job_card_number %> | Vehicle: <%= @job_card.vehicle&.display_name %></p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <%= render "form", estimate: @estimate %>
  </div>
</div>
