<%= form_with(model: [@job_card, estimate], class: "space-y-6") do |f| %>
  <% if estimate.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-xs font-medium text-red-700"><%= pluralize(estimate.errors.count, "error") %> prevented this estimate from being saved:</p>
      <ul class="mt-2 list-disc list-inside text-xs text-red-600">
        <% estimate.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Line Items -->
  <div>
    <h4 class="text-sm font-semibold text-gray-900 mb-3">Line Items</h4>
    <div id="estimate-items" class="space-y-3">
      <%= f.fields_for :line_items do |li_f| %>
        <div class="estimate-item-row rounded-lg border border-gray-200 p-3">
          <div class="grid grid-cols-1 sm:grid-cols-6 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
              <%= li_f.select :item_type, [["Labor", "labor"], ["Part", "part"]], {}, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
              <%= li_f.text_field :description, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Description" %>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Spare Part</label>
              <%= li_f.collection_select :spare_part_id, @spare_parts, :id, :name, { include_blank: "None" }, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Qty</label>
              <%= li_f.number_field :quantity, step: 0.01, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
            </div>
            <div class="flex items-end gap-2">
              <div class="flex-1">
                <label class="block text-xs font-medium text-gray-600 mb-1">Unit Price</label>
                <%= li_f.number_field :unit_price, step: 0.01, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
              </div>
              <%= li_f.hidden_field :_destroy, value: false, class: "destroy-field" %>
              <button type="button" onclick="this.closest('.estimate-item-row').querySelector('.destroy-field').value='1'; this.closest('.estimate-item-row').style.display='none'" class="rounded-lg border border-red-300 p-2 text-red-500 hover:bg-red-50 transition mb-0.5">
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Discount & Notes -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Discount Amount</label>
      <%= f.number_field :discount_amount, step: 0.01, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "0.00" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Discount Reason</label>
      <%= f.text_field :discount_reason, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Reason for discount" %>
    </div>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1.5">Notes</label>
    <%= f.text_area :notes, rows: 2, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Additional notes" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", job_card_path(@job_card), class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
  </div>
<% end %>
