<% content_for :page_title, "Schedule Follow-up" %>

<div class="max-w-2xl">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900">Schedule Follow-up</h2>
    <p class="text-xs text-gray-500 mt-1">Schedule an automated WhatsApp follow-up message for a lead</p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <%= form_with(model: @follow_up, class: "space-y-4") do |f| %>
      <% if @follow_up.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-3">
          <% @follow_up.errors.full_messages.each do |message| %>
            <p class="text-xs text-red-700"><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Lead</label>
        <%= f.select :lead_id, options_from_collection_for_select(@leads, :id, :name, @follow_up.lead_id), { include_blank: "Select a lead" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Message</label>
        <%= f.text_area :message, rows: 5, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Type the follow-up message..." %>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Scheduled At</label>
        <%= f.datetime_local_field :scheduled_at, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
        <p class="mt-1 text-[11px] text-gray-400">The message will be sent automatically at this time</p>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Schedule Follow-up", class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
        <%= link_to "Cancel", follow_ups_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
      </div>
    <% end %>
  </div>
</div>
