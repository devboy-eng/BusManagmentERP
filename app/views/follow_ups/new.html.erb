<% content_for :page_title, "Schedule Campaign" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Schedule Campaign</h2>
    <p class="text-xs text-gray-500 mt-1">Send an approved WhatsApp template to multiple recipients</p>
  </div>
  <%= link_to follow_ups_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
    &larr; Back to Campaigns
  <% end %>
</div>

<% if flash[:alert].present? %>
  <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3">
    <p class="text-xs text-red-700"><%= flash[:alert] %></p>
  </div>
<% end %>

<%= form_tag follow_ups_path, method: :post, id: "campaign-form", data: { controller: "follow-up-form" } do %>

  <%# ====== ROW 1: Recipients + Template & Preview (2 cards) ====== %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <%# Card 1 — Recipients %>
    <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
      <div class="border-b border-gray-200 px-5 py-3 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900">Recipients</h3>
        <span class="text-xs text-gray-500" data-follow-up-form-target="recipientCount">0 selected</span>
      </div>

      <%# Tabs %>
      <div class="flex border-b border-gray-200">
        <button type="button" data-action="click->follow-up-form#switchTab" data-tab="leads"
                data-follow-up-form-target="tab"
                class="flex-1 px-4 py-2.5 text-xs font-medium text-center transition border-b-2 border-indigo-600 text-indigo-600">
          Select Leads
        </button>
        <button type="button" data-action="click->follow-up-form#switchTab" data-tab="csv"
                data-follow-up-form-target="tab"
                class="flex-1 px-4 py-2.5 text-xs font-medium text-center transition border-b-2 border-transparent text-gray-500 hover:text-gray-700">
          Upload CSV
        </button>
      </div>

      <%# Select Leads Tab %>
      <div data-follow-up-form-target="tabPanel" data-tab="leads" class="p-4">
        <div class="mb-3 flex items-center gap-2">
          <input type="text" placeholder="Search leads by name or phone..."
                 data-action="input->follow-up-form#filterLeads"
                 data-follow-up-form-target="leadSearch"
                 class="flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
          <button type="button" data-action="click->follow-up-form#selectAllLeads" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-medium text-gray-600 hover:bg-gray-100 transition">Select All</button>
          <button type="button" data-action="click->follow-up-form#deselectAllLeads" class="rounded-lg border border-gray-300 px-3 py-2 text-[11px] font-medium text-gray-600 hover:bg-gray-100 transition">Deselect All</button>
        </div>
        <div class="space-y-1 max-h-72 overflow-y-auto" data-follow-up-form-target="leadsList">
          <% @leads.each do |lead| %>
            <label class="flex items-center gap-3 rounded-lg bg-gray-50 p-2.5 cursor-pointer hover:bg-gray-100 transition lead-item"
                   data-name="<%= lead.name.downcase %>" data-phone="<%= lead.phone %>">
              <input type="checkbox" name="lead_ids[]" value="<%= lead.id %>"
                     data-action="change->follow-up-form#updateRecipientCount"
                     data-follow-up-form-target="leadCheckbox"
                     class="h-4 w-4 rounded border-gray-300 bg-white text-indigo-600 focus:ring-indigo-500">
              <div>
                <p class="text-xs font-medium text-gray-900"><%= lead.name %></p>
                <p class="text-[11px] text-gray-500"><%= lead.phone %></p>
              </div>
            </label>
          <% end %>
          <% if @leads.empty? %>
            <p class="text-xs text-gray-500 text-center py-4">No leads available.</p>
          <% end %>
        </div>
      </div>

      <%# Upload CSV Tab %>
      <div data-follow-up-form-target="tabPanel" data-tab="csv" class="p-4 hidden">
        <div class="mb-3">
          <label class="block text-xs font-medium text-gray-700 mb-1">Upload CSV file (columns: name, phone)</label>
          <input type="file" accept=".csv"
                 data-action="change->follow-up-form#parseCSV"
                 data-follow-up-form-target="csvFile"
                 class="w-full text-xs text-gray-500 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-xs file:font-medium file:text-indigo-600 hover:file:bg-indigo-100">
          <p class="mt-1 text-[11px] text-gray-400">CSV must have "name" and "phone" columns</p>
        </div>
        <div data-follow-up-form-target="csvPreview" class="hidden">
          <p class="text-xs font-medium text-gray-700 mb-2">Parsed Contacts:</p>
          <div class="rounded-lg border border-gray-200 overflow-hidden max-h-48 overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-3 py-2 text-left text-[11px] font-semibold text-gray-500 uppercase">Name</th>
                  <th class="px-3 py-2 text-left text-[11px] font-semibold text-gray-500 uppercase">Phone</th>
                  <th class="px-3 py-2 text-right text-[11px] font-semibold text-gray-500 uppercase">Action</th>
                </tr>
              </thead>
              <tbody data-follow-up-form-target="csvTableBody" class="divide-y divide-gray-100"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <%# Card 2 — Template + Preview %>
    <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
      <div class="border-b border-gray-200 px-5 py-3">
        <h3 class="text-sm font-semibold text-gray-900">Template & Preview</h3>
      </div>

      <div class="p-5 space-y-4">
        <%# Template dropdown %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Approved Template</label>
          <select name="template_id" id="template-select"
                  data-action="change->follow-up-form#selectTemplate"
                  data-follow-up-form-target="templateSelect"
                  class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
            <option value="">-- Choose a template --</option>
            <% @templates.each do |template| %>
              <% var_count = template.category == "authentication" ? 1 : template.body.scan(/\{\{\d+\}\}/).size %>
              <option value="<%= template.id %>"
                      data-body="<%= h template.body %>"
                      data-header-type="<%= template.header_type %>"
                      data-header-text="<%= h(template.header_text.to_s) %>"
                      data-footer="<%= h(template.footer.to_s) %>"
                      data-category="<%= template.category %>"
                      data-buttons="<%= h(template.parsed_buttons.to_json) %>"
                      data-vars="<%= var_count %>"><%= template.name %> (<%= template.category&.titleize %>)</option>
            <% end %>
          </select>
        </div>

        <%# Variable Inputs (shown dynamically) %>
        <div data-follow-up-form-target="variablesSection" class="hidden space-y-2">
          <p class="text-xs font-medium text-gray-700">Template Variables</p>
          <div data-follow-up-form-target="variableInputs" class="space-y-2"></div>
        </div>

        <%# Phone mockup preview %>
        <div class="flex justify-center pt-2">
          <div class="w-[280px] rounded-[1.75rem] border-[3px] border-gray-800 bg-gray-800 shadow-lg overflow-hidden">
            <%# Phone notch %>
            <div class="bg-gray-800 flex items-center justify-center pt-1.5 pb-1">
              <div class="w-16 h-[4px] rounded-full bg-gray-600"></div>
            </div>

            <%# WhatsApp header %>
            <div class="bg-[#075E54] px-3 py-2 flex items-center gap-2">
              <svg class="h-3.5 w-3.5 text-white/90 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
              <div class="h-7 w-7 rounded-full bg-[#25D366] flex items-center justify-center flex-shrink-0">
                <svg class="h-3.5 w-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-white text-[12px] font-medium truncate">Recipient</p>
                <p class="text-white/60 text-[9px]">online</p>
              </div>
            </div>

            <%# Chat area %>
            <div class="relative min-h-[200px]" style="background-color: #ECE5DD; background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22 opacity=%220.04%22><text y=%2230%22 font-size=%2218%22>%F0%9F%92%AC</text></svg>');">
              <%# Date chip %>
              <div class="flex justify-center py-2.5">
                <span class="bg-white/80 text-[9px] text-gray-500 px-2.5 py-0.5 rounded-md shadow-sm">Today</span>
              </div>

              <%# Empty state %>
              <div data-follow-up-form-target="previewEmpty" class="px-4 pb-4 text-center">
                <p class="text-[11px] text-gray-500">Select a template to see preview</p>
              </div>

              <%# Message bubble (hidden by default) %>
              <div data-follow-up-form-target="previewBubble" class="px-2.5 pb-3 hidden">
                <div class="relative max-w-[88%] ml-auto">
                  <div class="bg-[#DCF8C6] rounded-lg rounded-tr-none p-2 shadow-sm">
                    <%# Media placeholder %>
                    <div data-follow-up-form-target="previewMedia" class="hidden mb-2 rounded-md bg-[#C5E8B0] flex items-center justify-center py-8 text-[#6B9F5B]">
                      <div class="text-center">
                        <svg class="h-6 w-6 mx-auto mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21z" /></svg>
                        <span data-follow-up-form-target="previewMediaLabel" class="text-[10px]">Image</span>
                      </div>
                    </div>

                    <%# Header text %>
                    <p data-follow-up-form-target="previewHeader" class="hidden text-[12px] font-semibold text-gray-900 mb-1"></p>

                    <%# Body %>
                    <p data-follow-up-form-target="previewBody" class="text-[12px] text-gray-900 whitespace-pre-wrap leading-[1.35]"></p>

                    <%# Footer %>
                    <p data-follow-up-form-target="previewFooter" class="hidden text-[10px] text-gray-500 mt-1"></p>

                    <%# Timestamp + check marks %>
                    <div class="flex items-center justify-end gap-1 mt-0.5">
                      <span class="text-[9px] text-gray-500"><%= Time.current.strftime("%I:%M %p") %></span>
                      <svg class="h-3 w-3 text-[#53BDEB]" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                        <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.97 4.97z"/>
                      </svg>
                    </div>
                  </div>

                  <%# Bubble tail %>
                  <div class="absolute top-0 -right-1.5 w-3 h-3 overflow-hidden">
                    <div class="bg-[#DCF8C6] w-3 h-3 rotate-45 transform origin-bottom-left"></div>
                  </div>

                  <%# Buttons container %>
                  <div data-follow-up-form-target="previewButtons" class="hidden"></div>
                </div>
              </div>
            </div>

            <%# Bottom bar %>
            <div class="bg-[#F0F0F0] px-2 py-1.5 flex items-center gap-1.5">
              <div class="flex-1 bg-white rounded-full px-2.5 py-1 flex items-center">
                <span class="text-[10px] text-gray-400">Type a message</span>
              </div>
              <div class="h-7 w-7 rounded-full bg-[#075E54] flex items-center justify-center flex-shrink-0">
                <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z" /></svg>
              </div>
            </div>

            <div class="bg-gray-800 flex justify-center py-1.5">
              <div class="w-20 h-1 rounded-full bg-gray-500"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ====== ROW 2: Schedule (full width) ====== %>
  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Schedule</h3>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-end">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Campaign Name (optional)</label>
        <input type="text" name="campaign_name" placeholder="e.g. July Follow-up Batch"
               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Scheduled At</label>
        <input type="datetime-local" name="scheduled_at"
               min="<%= Time.current.strftime("%Y-%m-%dT%H:%M") %>"
               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
               required>
      </div>

      <div class="flex items-center gap-3">
        <button type="submit" class="rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer">Schedule Campaign</button>
        <%= link_to "Cancel", follow_ups_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
      </div>
    </div>
  </div>

<% end %>
