<%= form_with(model: @template, data: { controller: "template-form" }) do |f| %>
  <div class="flex gap-8 items-start">
    <%# Left column — Form fields in a card %>
    <div class="flex-1 min-w-0">
      <div class="rounded-xl border border-gray-200 bg-white p-6 space-y-4">
        <% if @template.errors.any? %>
          <div class="rounded-lg bg-red-50 border border-red-200 p-3">
            <% @template.errors.full_messages.each do |message| %>
              <p class="text-xs text-red-700"><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <%# Template Type Chooser %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Choose Template Type</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="relative cursor-pointer" data-action="click->template-form#selectTemplateType" data-template-type="standard">
              <%= f.radio_button :template_type, "standard", class: "peer sr-only", data: { template_form_target: "templateTypeRadio" } %>
              <div class="peer-checked:border-indigo-500 peer-checked:ring-1 peer-checked:ring-indigo-500 peer-checked:bg-indigo-50 rounded-lg border border-gray-300 p-3 transition hover:border-gray-400">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
                  <span class="text-xs font-semibold text-gray-800">Header</span>
                </div>
                <p class="text-[11px] text-gray-500">Standard template with optional header, body, and footer</p>
              </div>
            </label>
            <label class="relative cursor-pointer" data-action="click->template-form#selectTemplateType" data-template-type="carousel">
              <%= f.radio_button :template_type, "carousel", class: "peer sr-only", data: { template_form_target: "templateTypeRadio" } %>
              <div class="peer-checked:border-indigo-500 peer-checked:ring-1 peer-checked:ring-indigo-500 peer-checked:bg-indigo-50 rounded-lg border border-gray-300 p-3 transition hover:border-gray-400">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-1.013.67-1.871 1.59-2.154" /></svg>
                  <span class="text-xs font-semibold text-gray-800">Carousel</span>
                </div>
                <p class="text-[11px] text-gray-500">Scrollable cards with images, text, and buttons (2-10 cards)</p>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Template Name</label>
          <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "e.g. Welcome Message" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Language</label>
            <%= f.select :language, WhatsappTemplate::LANGUAGES.map { |code, name| [name, code] }, {}, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
          </div>

          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Category</label>
            <%= f.select :category, WhatsappTemplate::CATEGORIES.map { |c| [c.titleize, c] }, { include_blank: "Select category" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
          </div>
        </div>

        <%# === Standard Template Fields === %>
        <div data-template-form-target="standardFields" class="<%= 'hidden' if @template.carousel? %> space-y-4">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Header Type</label>
            <%= f.select :header_type, WhatsappTemplate::HEADER_TYPES.map { |t| [t.titleize, t] }, {}, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", data: { template_form_target: "headerTypeSelect", action: "template-form#headerTypeChanged" } %>
          </div>

          <%# Conditional: Header Text %>
          <div class="<%= 'hidden' unless @template.header_type == 'text' %>" data-template-form-target="headerTextField">
            <div class="flex items-center gap-1.5 mb-1">
              <label class="block text-xs font-medium text-gray-700">Header Text</label>
              <div class="relative group">
                <button type="button" class="flex items-center justify-center h-4 w-4 rounded-full bg-gray-200 text-gray-500 hover:bg-indigo-100 hover:text-indigo-600 transition text-[9px] font-bold leading-none">i</button>
                <div class="hidden group-hover:block absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-56 rounded-lg bg-gray-900 text-white p-2.5 text-[11px] leading-relaxed shadow-lg z-50">
                  <p class="font-medium mb-1">Variables in Header</p>
                  <p class="text-gray-300">Use <span class="font-mono bg-gray-700 px-1 rounded">{{1}}</span> for a single variable in the header text.</p>
                  <p class="text-gray-400 mt-1">Example: <span class="italic">Hi {{1}}, welcome!</span></p>
                  <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
                </div>
              </div>
            </div>
            <%= f.text_field :header_text, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "e.g. Hello {{1}}!", data: { template_form_target: "headerTextInput", action: "input->template-form#updatePreview" } %>
          </div>

          <%# Conditional: Header Media URL with upload %>
          <div class="<%= 'hidden' unless @template.header_type.in?(%w[image video document]) %>" data-template-form-target="headerMediaField">
            <label class="block text-xs font-medium text-gray-700 mb-1">Header Media</label>
            <div data-controller="image-upload">
              <div class="flex gap-2">
                <%= f.text_field :header_media_url, class: "flex-1 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "https://example.com/image.jpg", data: { template_form_target: "headerMediaInput", action: "input->template-form#updatePreview", image_upload_target: "urlInput" } %>
                <button type="button" data-action="image-upload#pick" data-image-upload-target="uploadBtn" class="inline-flex items-center gap-1.5 rounded-lg bg-gray-100 px-3 py-2.5 text-[11px] font-medium text-gray-700 hover:bg-gray-200 transition whitespace-nowrap">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                  Upload
                </button>
                <input type="file" accept="image/*,video/*,.pdf,.doc,.docx" class="hidden" data-image-upload-target="fileInput" data-action="image-upload#upload">
              </div>
              <div class="hidden mt-2 h-20 w-20 rounded-lg border border-gray-200 overflow-hidden" data-image-upload-target="preview"></div>
              <p class="hidden mt-1 text-[11px] text-green-600" data-image-upload-target="filename"></p>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Footer <span class="text-gray-400 font-normal">(Optional)</span></label>
          <%= f.text_field :footer, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "e.g. Reply STOP to opt out", data: { template_form_target: "footerInput", action: "input->template-form#updatePreview" } %>
        </div>

        <div>
          <div class="flex items-center gap-1.5 mb-1">
            <label class="block text-xs font-medium text-gray-700">Message Body</label>
            <div class="relative group">
              <button type="button" class="flex items-center justify-center h-4 w-4 rounded-full bg-gray-200 text-gray-500 hover:bg-indigo-100 hover:text-indigo-600 transition text-[9px] font-bold leading-none">i</button>
              <div class="hidden group-hover:block absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-64 rounded-lg bg-gray-900 text-white p-3 text-[11px] leading-relaxed shadow-lg z-50">
                <p class="font-medium mb-1.5">Using Variables</p>
                <p class="text-gray-300">Add dynamic content with numbered placeholders:</p>
                <div class="mt-1.5 space-y-1 text-gray-300">
                  <p><span class="font-mono bg-gray-700 px-1 rounded">{{1}}</span> — Customer name</p>
                  <p><span class="font-mono bg-gray-700 px-1 rounded">{{2}}</span> — Order number, date, etc.</p>
                  <p><span class="font-mono bg-gray-700 px-1 rounded">{{3}}</span> — Any additional info</p>
                </div>
                <div class="mt-2 p-2 rounded bg-gray-800 text-gray-300">
                  <p class="text-gray-500 text-[10px] mb-0.5">Example:</p>
                  <p class="italic">Hi {{1}}, your order {{2}} has been shipped and will arrive by {{3}}.</p>
                </div>
                <p class="text-gray-500 mt-1.5 text-[10px]">Variables are replaced with actual values when the message is sent.</p>
                <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
              </div>
            </div>
          </div>
          <%= f.text_area :body, rows: 6, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "e.g. Hi {{1}}, your order {{2}} has been confirmed.", data: { template_form_target: "bodyInput", action: "input->template-form#updatePreview" } %>
        </div>

        <%# === Buttons Section (Standard templates only) === %>
        <div data-template-form-target="buttonsSection" class="<%= 'hidden' if @template.carousel? %> space-y-3">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-medium text-gray-700">Buttons <span class="text-gray-400 font-normal">(Optional)</span></label>
            <div class="flex items-center gap-1">
              <button type="button" data-action="template-form#addButton" data-button-type="QUICK_REPLY" class="rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-600 hover:bg-indigo-100 transition">+ Quick Reply</button>
              <button type="button" data-action="template-form#addButton" data-button-type="URL" class="rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-600 hover:bg-indigo-100 transition">+ URL</button>
              <button type="button" data-action="template-form#addButton" data-button-type="PHONE_NUMBER" class="rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-600 hover:bg-indigo-100 transition">+ Phone</button>
              <button type="button" data-action="template-form#addButton" data-button-type="COPY_CODE" class="rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-600 hover:bg-indigo-100 transition">+ Copy Code</button>
            </div>
          </div>

          <%# Mix warning banner %>
          <div data-template-form-target="buttonMixWarning" class="hidden rounded-lg bg-amber-50 border border-amber-200 p-2.5 flex items-start gap-2">
            <svg class="h-4 w-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
            <p class="text-[11px] text-amber-700">You cannot mix Quick Reply buttons with Call-to-Action buttons (URL, Phone, Copy Code). Please remove one type before adding another.</p>
          </div>

          <%# Buttons container %>
          <div data-template-form-target="buttonsContainer" class="grid grid-cols-2 gap-2">
            <% @template.parsed_buttons.each_with_index do |btn, i| %>
              <div class="button-row rounded-lg border border-gray-200 bg-gray-50 p-2.5 space-y-1.5" data-button-type="<%= btn['type'] %>">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center rounded bg-gray-200 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 whitespace-nowrap"><%= btn['type'].gsub('_', ' ') %></span>
                  <button type="button" data-action="template-form#removeButton" class="text-red-400 hover:text-red-600 transition">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>
                <input type="text" class="btn-text w-full rounded-lg border border-gray-300 bg-white px-2.5 py-1.5 text-[11px] text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" placeholder="Button text (max 25)" maxlength="25" value="<%= btn['text'] %>" data-action="input->template-form#updateButtonsData">
                <% if btn['type'] == 'URL' %>
                  <input type="text" class="btn-url w-full rounded-lg border border-gray-300 bg-white px-2.5 py-1.5 text-[11px] text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" placeholder="https://example.com/{{1}}" value="<%= btn['url'] %>" data-action="input->template-form#updateButtonsData">
                <% elsif btn['type'] == 'PHONE_NUMBER' %>
                  <input type="text" class="btn-phone w-full rounded-lg border border-gray-300 bg-white px-2.5 py-1.5 text-[11px] text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" placeholder="+919876543210" value="<%= btn['phone_number'] %>" data-action="input->template-form#updateButtonsData">
                <% end %>
              </div>
            <% end %>
          </div>

          <%# Hidden field to store buttons JSON %>
          <%= f.hidden_field :buttons, data: { template_form_target: "buttonsInput" } %>
        </div>

        <%# === Carousel Cards Section === %>
        <div data-template-form-target="carouselFields" class="<%= 'hidden' unless @template.carousel? %> space-y-4">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-medium text-gray-700">Carousel Cards <span class="text-gray-400 font-normal">(2-10 cards)</span></label>
            <button type="button" data-action="template-form#addCard" class="inline-flex items-center gap-1 rounded-lg bg-indigo-50 px-3 py-1.5 text-[11px] font-medium text-indigo-600 hover:bg-indigo-100 transition">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              Add Card
            </button>
          </div>

          <div data-template-form-target="cardsContainer" class="grid grid-cols-2 gap-3">
            <% cards = @template.parsed_carousel_cards %>
            <% if cards.any? %>
              <% cards.each_with_index do |card, i| %>
                <div class="carousel-card rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-3" data-card-index="<%= i %>">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-700">Card <%= i + 1 %></span>
                    <button type="button" data-action="template-form#removeCard" class="text-red-500 hover:text-red-600 transition">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                  </div>
                  <div data-controller="image-upload">
                    <label class="block text-[11px] font-medium text-gray-600 mb-1">Card Image</label>
                    <div class="flex gap-2">
                      <input type="text" class="card-image-url flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" placeholder="https://example.com/image.jpg" value="<%= card['image_url'] %>" data-action="input->template-form#updateCarouselData" data-image-upload-target="urlInput">
                      <button type="button" data-action="image-upload#pick" data-image-upload-target="uploadBtn" class="inline-flex items-center gap-1 rounded-lg bg-gray-100 px-2.5 py-2 text-[11px] font-medium text-gray-700 hover:bg-gray-200 transition whitespace-nowrap">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                        Upload
                      </button>
                      <input type="file" accept="image/*" class="hidden" data-image-upload-target="fileInput" data-action="image-upload#upload">
                    </div>
                    <div class="hidden mt-1.5 h-16 w-16 rounded border border-gray-200 overflow-hidden" data-image-upload-target="preview"></div>
                  </div>
                  <div>
                    <label class="block text-[11px] font-medium text-gray-600 mb-1">Card Body</label>
                    <textarea class="card-body w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" rows="2" placeholder="Card description text" data-action="input->template-form#updateCarouselData"><%= card['body'] %></textarea>
                  </div>
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <label class="block text-[11px] font-medium text-gray-600">Buttons <span class="text-gray-400 font-normal">(max 2)</span></label>
                      <select class="card-add-button rounded border border-gray-300 bg-white px-2 py-1 text-[10px] text-gray-600 focus:border-indigo-500 focus:outline-none" data-action="change->template-form#addCardButton">
                        <option value="">+ Add button</option>
                        <option value="QUICK_REPLY">Quick Reply</option>
                        <option value="URL">URL</option>
                        <option value="PHONE_NUMBER">Phone Number</option>
                      </select>
                    </div>
                    <div class="card-buttons-container space-y-1.5">
                      <% card_buttons = card["buttons"] || (card["button_text"].present? ? [{"type" => card["button_url"].present? ? "URL" : "QUICK_REPLY", "text" => card["button_text"], "url" => card["button_url"]}] : []) %>
                      <% card_buttons.each do |cb| %>
                        <div class="card-button-row flex items-center gap-1.5" data-button-type="<%= cb['type'] %>">
                          <span class="text-[9px] font-medium text-gray-500 w-8 shrink-0"><%= cb['type'] == 'URL' ? 'URL' : 'QR' %></span>
                          <input type="text" class="card-btn-text flex-1 rounded border border-gray-300 bg-white px-2 py-1 text-[11px] text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none" placeholder="Button text" maxlength="25" value="<%= cb['text'] %>" data-action="input->template-form#updateCarouselData">
                          <% if cb['type'] == 'URL' %>
                            <input type="text" class="card-btn-url flex-1 rounded border border-gray-300 bg-white px-2 py-1 text-[11px] text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none" placeholder="https://..." value="<%= cb['url'] %>" data-action="input->template-form#updateCarouselData">
                          <% end %>
                          <button type="button" data-action="template-form#removeCardButton" class="text-red-400 hover:text-red-600">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                          </button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>

          <%# Hidden field to store carousel cards JSON %>
          <%= f.hidden_field :carousel_cards, data: { template_form_target: "carouselCardsInput" } %>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
          <%= link_to "Cancel", whatsapp_templates_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
        </div>
      </div>
    </div>

    <%# Right column — Phone preview (sticky so it follows on scroll) %>
    <div class="w-80 flex-shrink-0 sticky top-6 self-start">
      <%= render "whatsapp_preview" %>
    </div>
  </div>
<% end %>
