<div class="sticky top-6">
  <h3 class="text-xs font-semibold text-gray-700 mb-3">Live Preview</h3>

  <%# Phone frame %>
  <div class="mx-auto w-[300px] rounded-[2rem] border-[3px] border-gray-800 bg-gray-800 shadow-xl overflow-hidden">

    <%# Phone notch / status bar %>
    <div class="bg-gray-800 flex items-center justify-center pt-2 pb-1">
      <div class="w-20 h-[5px] rounded-full bg-gray-600"></div>
    </div>

    <%# WhatsApp header bar %>
    <div class="bg-[#075E54] px-3 py-2.5 flex items-center gap-2.5">
      <%# Back arrow %>
      <svg class="h-4 w-4 text-white/90 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      <%# Avatar %>
      <div class="h-8 w-8 rounded-full bg-[#25D366] flex items-center justify-center flex-shrink-0">
        <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      </div>
      <%# Contact info %>
      <div class="flex-1 min-w-0">
        <p class="text-white text-[13px] font-medium truncate">Recipient</p>
        <p class="text-white/60 text-[10px]">online</p>
      </div>
      <%# Action icons %>
      <div class="flex items-center gap-3">
        <svg class="h-4 w-4 text-white/90" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25z" /></svg>
        <svg class="h-4 w-4 text-white/90" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" /></svg>
        <svg class="h-4 w-4 text-white/90" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 5.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 5.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5z" /></svg>
      </div>
    </div>

    <%# Chat area with WhatsApp wallpaper background %>
    <div class="relative h-[420px] overflow-y-auto" style="background-color: #ECE5DD; background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22 opacity=%220.04%22><text y=%2230%22 font-size=%2218%22>%F0%9F%92%AC</text></svg>');">

      <%# Date chip %>
      <div class="flex justify-center py-3">
        <span class="bg-white/80 text-[10px] text-gray-500 px-3 py-1 rounded-md shadow-sm">Today</span>
      </div>

      <%# Message bubble %>
      <div class="px-3 pb-3">
        <div class="relative max-w-[88%] ml-auto">
          <%# Bubble with WhatsApp green tint for sent messages %>
          <div class="bg-[#DCF8C6] rounded-lg rounded-tr-none p-2 shadow-sm">

            <%# Media placeholder %>
            <div class="hidden mb-2 rounded-md bg-[#C5E8B0] flex items-center justify-center py-10 text-[#6B9F5B]" data-template-form-target="previewMediaPlaceholder">
            </div>

            <%# Header text %>
            <p class="hidden text-[13px] font-semibold text-gray-900 mb-1" data-template-form-target="previewHeader">
              <%= @template.header_text if @template.header_type == "text" %>
            </p>

            <%# Body %>
            <p class="text-[13px] text-gray-900 whitespace-pre-wrap leading-[1.35]" data-template-form-target="previewBody"><%= @template.body.presence || "Message body will appear here..." %></p>

            <%# Footer %>
            <p class="text-[11px] text-gray-500 mt-1 <%= 'hidden' if @template.footer.blank? %>" data-template-form-target="previewFooter"><%= @template.footer %></p>

            <%# Timestamp + double check %>
            <div class="flex items-center justify-end gap-1 mt-0.5">
              <span class="text-[10px] text-gray-500"><%= Time.current.strftime("%I:%M %p") %></span>
              <%# Double check mark (delivered) %>
              <svg class="h-3.5 w-3.5 text-[#53BDEB]" viewBox="0 0 16 16" fill="currentColor">
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.97 4.97z"/>
              </svg>
            </div>
          </div>

          <%# Bubble tail %>
          <div class="absolute top-0 -right-1.5 w-3 h-3 overflow-hidden">
            <div class="bg-[#DCF8C6] w-3 h-3 rotate-45 transform origin-bottom-left"></div>
          </div>
        </div>
      </div>
    </div>

    <%# WhatsApp input bar %>
    <div class="bg-[#F0F0F0] px-2 py-2 flex items-center gap-2">
      <div class="flex-1 bg-white rounded-full px-3 py-1.5 flex items-center gap-2">
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>
        <span class="text-[12px] text-gray-400 flex-1">Type a message</span>
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" /></svg>
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0z" /></svg>
      </div>
      <div class="h-9 w-9 rounded-full bg-[#075E54] flex items-center justify-center flex-shrink-0">
        <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z" /></svg>
      </div>
    </div>

    <%# Phone bottom bar %>
    <div class="bg-gray-800 flex justify-center py-2">
      <div class="w-24 h-1 rounded-full bg-gray-500"></div>
    </div>
  </div>
</div>
