<% content_for :page_title, "WhatsApp Templates" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Message Templates</h2>
    <p class="text-xs text-gray-500 mt-1">Reusable message templates for WhatsApp</p>
  </div>
  <div class="flex items-center gap-2">
    <%= render "shared/guide_button", section: "templates" %>
    <%= link_to sync_all_whatsapp_templates_path, data: { turbo_method: :post, turbo_confirm: "Sync all templates from Meta? This will update status, language, and category for all synced templates." }, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs font-medium text-gray-700 hover:bg-gray-50 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
      Sync from Meta
    <% end %>
    <%= link_to new_whatsapp_template_path, class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      New Template
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden" data-controller="modal">
  <% if @templates.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Name</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Type</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Header</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Language</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Category</th>
          <th class="px-4 py-3 text-center text-[11px] font-semibold text-gray-500 uppercase">View Message</th>
          <th class="px-4 py-3 text-center text-[11px] font-semibold text-gray-500 uppercase">View Insights</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Created</th>
          <th class="px-4 py-3 text-right text-[11px] font-semibold text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @templates.each do |template| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs font-medium text-gray-900"><%= template.name %></td>
            <td class="px-4 py-3">
              <% if template.carousel? %>
                <span class="inline-flex items-center gap-1 rounded-full bg-purple-50 px-2 py-0.5 text-[11px] font-medium text-purple-700">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-1.013.67-1.871 1.59-2.154" /></svg>
                  Carousel
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-2 py-0.5 text-[11px] font-medium text-gray-600">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
                  Standard
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3"><%= template_status_badge(template.status) %></td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= template.header_display %></td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= template.language_name %></td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= template.category&.titleize || "-" %></td>
            <td class="px-4 py-3 text-center">
              <button data-action="modal#open" data-modal-id="message-modal-<%= template.id %>" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-500 text-xs font-medium">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                Preview
              </button>
            </td>
            <td class="px-4 py-3 text-center">
              <button data-action="modal#open" data-modal-id="insights-modal-<%= template.id %>" class="inline-flex items-center gap-1 text-gray-500 hover:text-gray-700 text-xs font-medium">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                Insights
              </button>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= template.created_at.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-1">
                <% if template.meta_template_id.blank? %>
                  <%= link_to sync_to_meta_whatsapp_template_path(template), data: { turbo_method: :post, turbo_confirm: "Submit this template to Meta for approval?" }, class: "h-8 w-8 rounded-full hover:bg-green-50 flex items-center justify-center transition", title: "Sync to Meta" do %>
                    <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
                  <% end %>
                <% else %>
                  <%= link_to sync_status_whatsapp_template_path(template), data: { turbo_method: :post }, class: "h-8 w-8 rounded-full hover:bg-blue-50 flex items-center justify-center transition", title: "Refresh Status" do %>
                    <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
                  <% end %>
                <% end %>
                <%= link_to edit_whatsapp_template_path(template), class: "h-8 w-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition", title: "Edit" do %>
                  <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                <% end %>
                <%= link_to whatsapp_template_path(template), data: { turbo_method: :delete, turbo_confirm: "Delete this template?" }, class: "h-8 w-8 rounded-full hover:bg-red-50 flex items-center justify-center transition", title: "Delete" do %>
                  <svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%# Render modals for each template %>
    <% @templates.each do |template| %>
      <%= render "message_preview_modal", template: template %>
      <%= render "insights_modal", template: template %>
    <% end %>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-xs text-gray-500">No templates yet.</p>
      <p class="text-xs text-gray-400 mt-1">Create your first message template to get started.</p>
    </div>
  <% end %>
</div>
