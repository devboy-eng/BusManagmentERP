<div id="insights-modal-<%= template.id %>" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" data-modal-container>
  <%# Backdrop %>
  <div class="absolute inset-0 bg-black/50" data-action="click->modal#close"></div>

  <%# Modal content %>
  <div class="relative w-full max-w-sm rounded-xl bg-white shadow-xl" data-controller="modal">
    <%# Header %>
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900">Template Insights</h3>
      <button data-action="modal#close" class="text-gray-400 hover:text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <%# Placeholder content %>
    <div class="p-8 text-center">
      <svg class="h-10 w-10 mx-auto text-gray-300 mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
      </svg>
      <p class="text-sm font-medium text-gray-700">Insights will be available soon</p>
      <p class="text-xs text-gray-400 mt-1">Template analytics and delivery metrics for "<%= template.name %>" will appear here once connected to Meta.</p>
    </div>
  </div>
</div>
