<div id="message-modal-<%= template.id %>" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" data-modal-container>
  <%# Backdrop %>
  <div class="absolute inset-0 bg-black/50" data-action="click->modal#close"></div>

  <%# Modal content %>
  <div class="relative w-full max-w-sm rounded-xl bg-white shadow-xl" data-controller="modal">
    <%# Modal header %>
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
      <h3 class="text-sm font-semibold text-gray-900"><%= template.name %></h3>
      <button data-action="modal#close" class="text-gray-400 hover:text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <%# Phone mockup inside modal %>
    <div class="p-5">
      <div class="mx-auto w-[280px] rounded-[1.75rem] border-[3px] border-gray-800 bg-gray-800 shadow-lg overflow-hidden">

        <%# Phone notch %>
        <div class="bg-gray-800 flex items-center justify-center pt-1.5 pb-1">
          <div class="w-16 h-[4px] rounded-full bg-gray-600"></div>
        </div>

        <%# WhatsApp header %>
        <div class="bg-[#075E54] px-3 py-2 flex items-center gap-2">
          <svg class="h-3.5 w-3.5 text-white/90 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
          <div class="h-7 w-7 rounded-full bg-[#25D366] flex items-center justify-center flex-shrink-0">
            <svg class="h-3.5 w-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-white text-[12px] font-medium truncate">Recipient</p>
            <p class="text-white/60 text-[9px]">online</p>
          </div>
        </div>

        <%# Chat area %>
        <div class="relative min-h-[200px]" style="background-color: #ECE5DD; background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22 opacity=%220.04%22><text y=%2230%22 font-size=%2218%22>%F0%9F%92%AC</text></svg>');">
          <%# Date chip %>
          <div class="flex justify-center py-2.5">
            <span class="bg-white/80 text-[9px] text-gray-500 px-2.5 py-0.5 rounded-md shadow-sm">Today</span>
          </div>

          <% if template.carousel? %>
            <%# ====== CAROUSEL preview ====== %>
            <%# Body bubble %>
            <div class="px-2.5 pb-2">
              <div class="relative max-w-[88%] ml-auto">
                <div class="bg-[#DCF8C6] rounded-lg rounded-tr-none p-2 shadow-sm">
                  <p class="text-[12px] text-gray-900 whitespace-pre-wrap leading-[1.35]"><%= template.body %></p>
                  <% if template.footer.present? %>
                    <p class="text-[10px] text-gray-500 mt-1"><%= template.footer %></p>
                  <% end %>
                  <div class="flex items-center justify-end gap-1 mt-0.5">
                    <span class="text-[9px] text-gray-500"><%= Time.current.strftime("%I:%M %p") %></span>
                    <svg class="h-3 w-3 text-[#53BDEB]" viewBox="0 0 16 16" fill="currentColor">
                      <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                      <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.97 4.97z"/>
                    </svg>
                  </div>
                </div>
                <div class="absolute top-0 -right-1.5 w-3 h-3 overflow-hidden">
                  <div class="bg-[#DCF8C6] w-3 h-3 rotate-45 transform origin-bottom-left"></div>
                </div>
              </div>
            </div>

            <%# Scrollable carousel cards %>
            <% cards = template.parsed_carousel_cards %>
            <% if cards.any? %>
              <div class="px-2.5 pb-3">
                <div class="flex gap-1.5 overflow-x-auto pb-1" style="scrollbar-width: thin;">
                  <% cards.each_with_index do |card, i| %>
                    <div class="flex-shrink-0 rounded-lg overflow-hidden shadow" style="background-color: #DCF8C6; width: calc(100% - 12px);">
                      <div style="position:relative; height:100px; background:#C5E8B0; overflow:hidden;">
                        <% if card['image_url'].present? %>
                          <img src="<%= card['image_url'] %>" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;">
                        <% else %>
                          <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                            <svg class="h-6 w-6 text-[#8BC88A]" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21z" /></svg>
                          </div>
                        <% end %>
                      </div>
                      <div class="px-2 py-1.5">
                        <p class="text-[11px] text-gray-900 leading-[1.3] line-clamp-2"><%= card['body'].presence || "Card #{i + 1}" %></p>
                      </div>
                      <% if card['button_text'].present? %>
                        <div style="border-top: 1px solid rgba(0,0,0,0.08);">
                          <div class="py-1.5 text-center">
                            <span class="text-[11px] font-medium" style="color: #00A5F4;"><%= card['button_text'] %></span>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

          <% else %>
            <%# ====== STANDARD message bubble ====== %>
            <div class="px-2.5 pb-3">
              <div class="relative max-w-[88%] ml-auto">
                <div class="bg-[#DCF8C6] rounded-lg rounded-tr-none p-2 shadow-sm">

                  <%# Media placeholder %>
                  <% if template.header_type.in?(%w[image video document]) %>
                    <div class="mb-2 rounded-md bg-[#C5E8B0] flex items-center justify-center py-8 text-[#6B9F5B]">
                      <div class="text-center">
                        <% case template.header_type %>
                        <% when "image" %>
                          <svg class="h-6 w-6 mx-auto mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21z" /></svg>
                          <span class="text-[10px]">Image</span>
                        <% when "video" %>
                          <svg class="h-6 w-6 mx-auto mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25z" /></svg>
                          <span class="text-[10px]">Video</span>
                        <% when "document" %>
                          <svg class="h-6 w-6 mx-auto mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z" /></svg>
                          <span class="text-[10px]">Document</span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <%# Header text %>
                  <% if template.header_type == "text" && template.header_text.present? %>
                    <p class="text-[12px] font-semibold text-gray-900 mb-1"><%= template.header_text %></p>
                  <% end %>

                  <%# Body %>
                  <p class="text-[12px] text-gray-900 whitespace-pre-wrap leading-[1.35]"><%= template.body %></p>

                  <%# Footer %>
                  <% if template.footer.present? %>
                    <p class="text-[10px] text-gray-500 mt-1"><%= template.footer %></p>
                  <% end %>

                  <%# Timestamp + check marks %>
                  <div class="flex items-center justify-end gap-1 mt-0.5">
                    <span class="text-[9px] text-gray-500"><%= Time.current.strftime("%I:%M %p") %></span>
                    <svg class="h-3 w-3 text-[#53BDEB]" viewBox="0 0 16 16" fill="currentColor">
                      <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                      <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.97 4.97z"/>
                    </svg>
                  </div>
                </div>

                <%# Bubble tail %>
                <div class="absolute top-0 -right-1.5 w-3 h-3 overflow-hidden">
                  <div class="bg-[#DCF8C6] w-3 h-3 rotate-45 transform origin-bottom-left"></div>
                </div>

                <%# Buttons %>
                <% btns = template.parsed_buttons %>
                <% if btns.any? %>
                  <% has_qr = btns.any? { |b| b["type"] == "QUICK_REPLY" } %>
                  <% if has_qr %>
                    <%# Quick Reply buttons — horizontal pills %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <% btns.select { |b| b["type"] == "QUICK_REPLY" }.each do |b| %>
                        <div class="rounded-lg bg-white border border-gray-200 px-2.5 py-1 text-center shadow-sm" style="flex: 1 1 auto; min-width: 0;">
                          <span class="text-[11px] font-medium" style="color: #00A5F4;"><%= b["text"] %></span>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <%# CTA buttons — full width with icons %>
                    <% btns.each do |b| %>
                      <div class="rounded-lg bg-white border border-gray-200 px-2.5 py-1.5 text-center shadow-sm mt-1 flex items-center justify-center gap-1">
                        <% if b["type"] == "URL" %>
                          <svg class="h-3 w-3" style="color: #00A5F4;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                        <% elsif b["type"] == "PHONE_NUMBER" %>
                          <svg class="h-3 w-3" style="color: #00A5F4;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" /></svg>
                        <% elsif b["type"] == "COPY_CODE" %>
                          <svg class="h-3 w-3" style="color: #00A5F4;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" /></svg>
                        <% end %>
                        <span class="text-[11px] font-medium" style="color: #00A5F4;"><%= b["text"] %></span>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <%# Bottom bar %>
        <div class="bg-[#F0F0F0] px-2 py-1.5 flex items-center gap-1.5">
          <div class="flex-1 bg-white rounded-full px-2.5 py-1 flex items-center">
            <span class="text-[10px] text-gray-400">Type a message</span>
          </div>
          <div class="h-7 w-7 rounded-full bg-[#075E54] flex items-center justify-center flex-shrink-0">
            <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z" /></svg>
          </div>
        </div>

        <div class="bg-gray-800 flex justify-center py-1.5">
          <div class="w-20 h-1 rounded-full bg-gray-500"></div>
        </div>
      </div>

      <%# Metadata below phone %>
      <div class="mt-3 flex items-center justify-center gap-3 text-[11px] text-gray-400">
        <span>Language: <%= template.language_name %></span>
        <span>&middot;</span>
        <span>Category: <%= template.category&.titleize || "—" %></span>
      </div>
    </div>
  </div>
</div>
