<% content_for :page_title, "Add New Role" %>
<div class="max-w-lg">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900">Add New Role</h2>
  </div>
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <%= form_with(model: @role, class: "space-y-5") do |f| %>
      <% if @role.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-4">
          <ul class="list-disc list-inside text-xs text-red-600">
            <% @role.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Role Name</label>
        <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Enter role name" %>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit "Create Role", class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
        <%= link_to "Cancel", roles_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
      </div>
    <% end %>
  </div>
</div>
