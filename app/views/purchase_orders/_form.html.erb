<%= form_with(model: purchase_order, class: "space-y-6") do |f| %>
  <% if purchase_order.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-xs font-medium text-red-700"><%= pluralize(purchase_order.errors.count, "error") %> prevented this purchase order from being saved:</p>
      <ul class="mt-2 list-disc list-inside text-xs text-red-600">
        <% purchase_order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Supplier *</label>
      <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Select supplier" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Warehouse *</label>
      <%= f.collection_select :warehouse_id, @warehouses, :id, :name, { include_blank: "Select warehouse" }, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Expected Delivery Date</label>
      <%= f.date_field :expected_delivery_date, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1.5">Notes</label>
    <%= f.text_area :notes, rows: 2, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Additional notes" %>
  </div>

  <!-- Nested Items -->
  <div>
    <h4 class="text-sm font-semibold text-gray-900 mb-3">Order Items</h4>
    <div id="po-items" class="space-y-3">
      <%= f.fields_for :items do |item_f| %>
        <div class="flex items-end gap-3 po-item-row rounded-lg border border-gray-200 p-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-600 mb-1">Spare Part</label>
            <%= item_f.collection_select :spare_part_id, @spare_parts, :id, :name, { include_blank: "Select part" }, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
          </div>
          <div class="w-28">
            <label class="block text-xs font-medium text-gray-600 mb-1">Quantity</label>
            <%= item_f.number_field :ordered_quantity, min: 1, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Qty" %>
          </div>
          <div class="w-32">
            <label class="block text-xs font-medium text-gray-600 mb-1">Unit Cost</label>
            <%= item_f.number_field :unit_cost, step: 0.01, class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Cost" %>
          </div>
          <div>
            <%= item_f.hidden_field :_destroy, value: false, class: "destroy-field" %>
            <button type="button" onclick="this.closest('.po-item-row').querySelector('.destroy-field').value='1'; this.closest('.po-item-row').style.display='none'" class="rounded-lg border border-red-300 p-2 text-red-500 hover:bg-red-50 transition">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", purchase_orders_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
  </div>
<% end %>
