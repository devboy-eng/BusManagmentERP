<% content_for :page_title, "Revenue Report" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Revenue Report</h2>
    <p class="text-xs text-gray-500 mt-1">Payment revenue by date range</p>
  </div>
  <%= link_to reports_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
    Back to Reports
  <% end %>
</div>

<div class="rounded-xl border border-gray-200 bg-white p-6 mb-6">
  <%= form_tag reports_revenue_path, method: :get, class: "flex items-end gap-4" do %>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">Start Date</label>
      <%= date_field_tag :start_date, @start_date, class: "rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1.5">End Date</label>
      <%= date_field_tag :end_date, @end_date, class: "rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <%= submit_tag "Apply", class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500 uppercase">Total Revenue</p>
    <p class="text-xl font-bold text-gray-900 mt-1"><%= number_to_currency(@total_revenue, unit: "\u20B9") %></p>
  </div>
  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500 uppercase">Payments Count</p>
    <p class="text-xl font-bold text-gray-900 mt-1"><%= @payments.count %></p>
  </div>
  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <p class="text-[11px] text-gray-500 uppercase">Avg. Payment</p>
    <p class="text-xl font-bold text-gray-900 mt-1"><%= @payments.count > 0 ? number_to_currency(@total_revenue / @payments.count, unit: "\u20B9") : number_to_currency(0, unit: "\u20B9") %></p>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Revenue</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @daily_revenue.sort.each do |date, amount| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= date.to_date.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= number_to_currency(amount, unit: "\u20B9") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @daily_revenue.empty? %>
    <div class="text-center py-12">
      <p class="text-xs text-gray-500">No revenue data for the selected period.</p>
    </div>
  <% end %>
</div>
