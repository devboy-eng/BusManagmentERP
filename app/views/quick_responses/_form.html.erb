<%= form_with(model: quick_response, class: "space-y-5") do |f| %>
  <% if quick_response.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-3">
      <p class="text-xs font-medium text-red-700"><%= pluralize(quick_response.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc pl-4">
        <% quick_response.errors.full_messages.each do |msg| %>
          <li class="text-[11px] text-red-600"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. Thank You Reply" %>
  </div>

  <div>
    <%= f.label :shortcode, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_field :shortcode, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "e.g. /thanks" %>
    <p class="text-[11px] text-gray-400 mt-1">Type this shortcode in chat to quickly insert this response</p>
  </div>

  <div>
    <%= f.label :body, class: "block text-xs font-medium text-gray-700 mb-1" %>
    <%= f.text_area :body, rows: 4, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none", placeholder: "Type your quick response message..." %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
    <%= link_to "Cancel", quick_responses_path, class: "text-xs text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
