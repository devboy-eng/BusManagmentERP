<% content_for :page_title, "Service Reminders" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Service Reminders</h2>
    <p class="text-xs text-gray-500 mt-1"><%= @pagy.count %> total reminders</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_tag service_reminders_path, method: :get, class: "flex items-center gap-2" do %>
      <%= select_tag :status, options_for_select([["All Statuses", ""]] + ServiceReminder.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), class: "rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-xs text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      <%= submit_tag "Filter", class: "rounded-lg bg-gray-100 border border-gray-300 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition cursor-pointer" %>
      <% if params[:status].present? %>
        <%= link_to "Clear", service_reminders_path, class: "text-xs text-gray-500 hover:text-gray-900 transition" %>
      <% end %>
    <% end %>
    <%= link_to new_service_reminder_path, class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Add Reminder
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @reminders.each do |reminder| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= reminder.vehicle&.display_name %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= reminder.customer&.name %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= reminder.reminder_type&.humanize %></td>
            <td class="px-4 py-3 text-xs <%= reminder.due_date < Date.current ? 'text-red-600 font-medium' : 'text-gray-600' %>">
              <%= reminder.due_date.strftime("%d %b %Y") %>
              <% if reminder.due_date < Date.current && reminder.pending? %>
                <span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-medium text-red-700">Overdue</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% status_colors = { "pending" => "bg-yellow-100 text-yellow-800", "sent" => "bg-blue-100 text-blue-800", "acknowledged" => "bg-indigo-100 text-indigo-800", "completed" => "bg-green-100 text-green-800" } %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= status_colors[reminder.status] || 'bg-gray-100 text-gray-800' %>">
                <%= reminder.status.humanize %>
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= link_to edit_service_reminder_path(reminder), class: "text-gray-500 hover:text-yellow-500 transition", title: "Edit" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                <% end %>
                <%= link_to service_reminder_path(reminder), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-gray-500 hover:text-red-500 transition", title: "Delete" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @reminders.empty? %>
    <div class="text-center py-12">
      <p class="mt-3 text-xs text-gray-500">No service reminders found.</p>
      <%= link_to "Create your first reminder", new_service_reminder_path, class: "mt-2 inline-block text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500">Showing <%= @pagy.from %> to <%= @pagy.to %> of <%= @pagy.count %> results</p>
      <nav class="flex items-center gap-1">
        <% if @pagy.prev %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.prev)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Prev<% end %>
        <% end %>
        <% @pagy.series.each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "rounded-lg px-3 py-1.5 text-xs #{item == @pagy.page ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" %>
          <% elsif item.is_a?(String) %>
            <span class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs text-white"><%= item %></span>
          <% elsif item == :gap %>
            <span class="px-2 text-gray-500">...</span>
          <% end %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.next)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Next<% end %>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>
