<% content_for :page_title, "Lead Details" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @lead.name %></h2>
    <p class="text-xs text-gray-500 mt-1">Lead details and remarks</p>
  </div>
  <div class="flex items-center gap-3">
    <button type="button" onclick="document.getElementById('whatsapp-modal').classList.remove('hidden')" class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      Send WhatsApp
    </button>
    <%= link_to edit_lead_path(@lead), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      Edit
    <% end %>
    <%= link_to leads_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>Back to List<% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Lead Information</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Name</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.name %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Phone</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.phone %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Email</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.email || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">PAN</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.pan || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">GST</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.gst || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Trademark</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.trademark || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Category</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.category || "-" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Status</dt>
          <dd class="mt-1"><%= status_badge(@lead.status, :lead) %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-3">
          <dt class="text-[11px] text-gray-500">Created</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.created_at.strftime("%d %b %Y, %I:%M %p") %></dd>
        </div>
      </dl>

      <!-- Change Status -->
      <div class="mt-4 rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500 mb-2">Change Status</dt>
        <dd class="flex flex-wrap gap-2">
          <%= link_to "Pending", update_status_lead_path(@lead, status: :pending), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@lead.pending? ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : 'bg-white text-yellow-700 border-yellow-200 hover:bg-yellow-50'}" %>
          <%= link_to "Contacted", update_status_lead_path(@lead, status: :contacted), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@lead.contacted? ? 'bg-green-100 text-green-800 border-green-300' : 'bg-white text-green-700 border-green-200 hover:bg-green-50'}" %>
          <%= link_to "Follow Up", update_status_lead_path(@lead, status: :follow_up), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@lead.follow_up? ? 'bg-purple-100 text-purple-800 border-purple-300' : 'bg-white text-purple-700 border-purple-200 hover:bg-purple-50'}" %>
          <%= link_to "Work In Process", update_status_lead_path(@lead, status: :work_in_process), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@lead.work_in_process? ? 'bg-blue-100 text-blue-800 border-blue-300' : 'bg-white text-blue-700 border-blue-200 hover:bg-blue-50'}" %>
          <%= link_to "Not Interested", update_status_lead_path(@lead, status: :not_interested), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition #{@lead.not_interested? ? 'bg-red-100 text-red-800 border-red-300' : 'bg-white text-red-700 border-red-200 hover:bg-red-50'}" %>
        </dd>
      </div>
      <% if @lead.address.present? %>
        <div class="rounded-lg bg-gray-50 p-3 mt-4">
          <dt class="text-[11px] text-gray-500">Address</dt>
          <dd class="text-xs text-gray-900 mt-1"><%= @lead.address %></dd>
        </div>
      <% end %>
    </div>

    <!-- WhatsApp Messages -->
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900">Recent WhatsApp Messages</h3>
        <%= link_to "Schedule Follow-up", new_follow_up_path(lead_id: @lead.id), class: "text-xs text-indigo-600 hover:text-indigo-500" %>
      </div>
      <% if @whatsapp_messages.any? %>
        <div class="space-y-3">
          <% @whatsapp_messages.each do |msg| %>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="flex items-center justify-between mb-1">
                <p class="text-xs text-gray-500 truncate flex-1"><%= truncate(msg.message_body, length: 80) %></p>
                <%= whatsapp_status_badge(msg.status) %>
              </div>
              <p class="text-[11px] text-gray-400"><%= msg.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500 text-center py-4">No WhatsApp messages sent to this lead yet.</p>
      <% end %>
    </div>

    <!-- Follow-ups -->
    <% if @follow_ups.any? %>
      <div class="rounded-xl border border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Follow-ups</h3>
          <%= link_to "View All", follow_ups_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
        </div>
        <div class="space-y-3">
          <% @follow_ups.each do |fu| %>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="flex items-center justify-between mb-1">
                <p class="text-xs text-gray-500 truncate flex-1"><%= truncate(fu.message, length: 80) %></p>
                <%= follow_up_status_badge(fu.status) %>
              </div>
              <p class="text-[11px] text-gray-400">Scheduled: <%= fu.scheduled_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Comments / Remarks -->
  <div>
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Remarks</h3>

      <%= form_with(model: [@lead, @comment], class: "mb-4") do |f| %>
        <%= f.text_area :body, rows: 3, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-xs text-gray-900 placeholder-gray-500 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Add a remark..." %>
        <%= f.submit "Add Remark", class: "mt-2 w-full rounded-lg bg-indigo-600 px-4 py-2 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
      <% end %>

      <div class="space-y-3 max-h-96 overflow-y-auto">
        <% @comments.each do |comment| %>
          <div class="rounded-lg bg-gray-50 p-3">
            <p class="text-xs text-gray-900"><%= comment.body %></p>
            <div class="mt-2 flex items-center gap-2 text-[11px] text-gray-500">
              <span class="font-medium text-indigo-600"><%= comment.user.name %></span>
              <span>&middot;</span>
              <span><%= comment.created_at.strftime("%d %b %Y, %I:%M %p") %></span>
            </div>
          </div>
        <% end %>
        <% if @comments.empty? %>
          <p class="text-xs text-gray-500 text-center py-4">No remarks yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- WhatsApp Quick Send Modal -->
<div id="whatsapp-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500/75" onclick="document.getElementById('whatsapp-modal').classList.add('hidden')"></div>
    <div class="relative rounded-xl bg-white p-6 shadow-xl w-full max-w-md">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Send WhatsApp to <%= @lead.name %></h3>
      <%= form_tag send_quick_whatsapp_marketing_index_path, method: :post do %>
        <%= hidden_field_tag :recipient_type, "Lead" %>
        <%= hidden_field_tag :recipient_id, @lead.id %>
        <%= text_area_tag :message, nil, rows: 4, class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-xs text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none", placeholder: "Type your message..." %>
        <div class="flex items-center gap-3 mt-4">
          <%= submit_tag "Send", class: "rounded-lg bg-green-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-green-500 transition cursor-pointer" %>
          <button type="button" onclick="document.getElementById('whatsapp-modal').classList.add('hidden')" class="rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
