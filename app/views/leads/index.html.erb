<% content_for :page_title, "Leads" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">All Leads</h2>
    <p class="text-xs text-gray-500 mt-1"><%= @pagy.count %> total leads</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_tag leads_path, method: :get, class: "flex items-center gap-2" do %>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
        <%= text_field_tag :search, params[:search], placeholder: "Search leads...", class: "w-56 rounded-lg border border-gray-300 bg-white pl-10 pr-4 py-2.5 text-xs text-gray-900 placeholder-gray-500 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
      </div>
      <%= submit_tag "Search", class: "rounded-lg bg-gray-100 border border-gray-300 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition cursor-pointer" %>
      <% if params[:search].present? %>
        <%= link_to "Clear", leads_path, class: "text-xs text-gray-500 hover:text-gray-900 transition" %>
      <% end %>
    <% end %>
    <%= link_to bulk_upload_leads_path, class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
      Bulk Upload
    <% end %>
    <%= link_to new_lead_path, class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Add Lead
    <% end %>
  </div>
</div>

<!-- Table -->
<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("Name", :name, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("Phone", :phone, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("Email", :email, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("PAN", :pan, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("GST", :gst, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("Category", :category, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link("Last Updated", :updated_at, params[:sort], params[:direction]) %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs text-gray-900 font-medium"><%= lead.name %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= lead.phone %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= lead.email %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= lead.pan %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= lead.gst %></td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= lead.category || "-" %></td>
            <td class="px-4 py-3">
              <div class="relative" data-controller="dropdown">
                <button data-action="click->dropdown#toggle" class="cursor-pointer">
                  <%= status_badge(lead.status, :lead) %>
                </button>
                <div data-dropdown-target="menu" class="hidden absolute z-10 mt-1 w-40 rounded-lg bg-white border border-gray-200 shadow-lg py-1">
                  <%= link_to "Pending", update_status_lead_path(lead, status: :pending), data: { turbo_method: :patch }, class: "block px-3 py-1.5 text-xs text-yellow-700 hover:bg-gray-100" %>
                  <%= link_to "Contacted", update_status_lead_path(lead, status: :contacted), data: { turbo_method: :patch }, class: "block px-3 py-1.5 text-xs text-green-700 hover:bg-gray-100" %>
                  <%= link_to "Follow Up", update_status_lead_path(lead, status: :follow_up), data: { turbo_method: :patch }, class: "block px-3 py-1.5 text-xs text-purple-700 hover:bg-gray-100" %>
                  <%= link_to "Work In Process", update_status_lead_path(lead, status: :work_in_process), data: { turbo_method: :patch }, class: "block px-3 py-1.5 text-xs text-blue-700 hover:bg-gray-100" %>
                  <%= link_to "Not Interested", update_status_lead_path(lead, status: :not_interested), data: { turbo_method: :patch }, class: "block px-3 py-1.5 text-xs text-red-700 hover:bg-gray-100" %>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= lead.updated_at.strftime("%d %b %Y, %I:%M %p") %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= link_to lead_path(lead), class: "text-gray-500 hover:text-indigo-600 transition", title: "View" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <% end %>
                <%= link_to edit_lead_path(lead), class: "text-gray-500 hover:text-yellow-500 transition", title: "Edit" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                <% end %>
                <%= link_to lead_path(lead), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this lead?" }, class: "text-gray-500 hover:text-red-500 transition", title: "Delete" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @leads.empty? %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
      <p class="mt-3 text-xs text-gray-500">No leads found.</p>
      <%= link_to "Add your first lead", new_lead_path, class: "mt-2 inline-block text-xs text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500">Showing <%= @pagy.from %> to <%= @pagy.to %> of <%= @pagy.count %> results</p>
      <nav class="flex items-center gap-1">
        <% if @pagy.prev %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.prev)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Prev<% end %>
        <% end %>
        <% @pagy.series.each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "rounded-lg px-3 py-1.5 text-xs #{item == @pagy.page ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" %>
          <% elsif item.is_a?(String) %>
            <span class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs text-white"><%= item %></span>
          <% elsif item == :gap %>
            <span class="px-2 text-gray-500">...</span>
          <% end %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to url_for(request.query_parameters.merge(page: @pagy.next)), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-100" do %>Next<% end %>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>
