<% content_for :page_title, "Bulk Upload Leads" %>
<div class="max-w-2xl">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900">Bulk Upload Leads</h2>
    <p class="text-xs text-gray-500 mt-1">Upload a CSV file to import multiple leads at once.</p>
  </div>
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <%= form_tag import_leads_path, multipart: true, class: "space-y-5" do %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-3">Select CSV File</label>
        <div class="flex items-center justify-center w-full">
          <label class="flex flex-col items-center justify-center w-full h-40 border-2 border-gray-300 border-dashed rounded-xl cursor-pointer bg-gray-50 hover:bg-gray-100 transition">
            <div class="flex flex-col items-center justify-center pt-5 pb-6">
              <svg class="w-8 h-8 mb-3 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
              <p class="mb-1 text-xs text-gray-600"><span class="font-semibold">Click to upload</span> CSV file</p>
              <p class="text-[11px] text-gray-500">CSV format only</p>
            </div>
            <%= file_field_tag :file, accept: ".csv", class: "hidden" %>
          </label>
        </div>
      </div>
      <div class="rounded-lg bg-gray-50 p-4">
        <p class="text-xs font-medium text-gray-600 mb-2">CSV Format</p>
        <p class="text-[11px] text-gray-500">Your CSV should have these column headers:</p>
        <code class="mt-2 block text-[11px] text-indigo-600 bg-gray-50 rounded-lg p-2">Name, Phone, Email, Address, PAN, GST, Trademark</code>
      </div>
      <div class="flex items-center gap-3">
        <%= submit_tag "Upload & Import", class: "rounded-lg bg-indigo-600 px-6 py-2.5 text-xs font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
        <%= link_to "Cancel", leads_path, class: "rounded-lg border border-gray-300 px-6 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" %>
      </div>
    <% end %>
  </div>
</div>
