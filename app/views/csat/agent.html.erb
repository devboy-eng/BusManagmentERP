<% content_for :page_title, "CSAT – #{@agent.name}" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <%= link_to "CSAT Analytics", csat_index_path, class: "text-xs text-indigo-600 hover:text-indigo-500" %>
      <span class="text-xs text-gray-400">/</span>
      <span class="text-xs text-gray-500"><%= @agent.name %></span>
    </div>
    <h2 class="text-lg font-semibold text-gray-900"><%= @agent.name %></h2>
    <p class="text-xs text-gray-500 mt-1">Individual agent satisfaction metrics and feedback</p>
  </div>
</div>

<!-- Agent Stats Cards -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Overall Score</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @overall_score %><span class="text-sm text-gray-400">/5</span></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-indigo-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
      </div>
    </div>
    <p class="text-[11px] text-gray-400 mt-2"><%= @total_responses %> responses</p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Service Rating</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @avg_service %><span class="text-sm text-gray-400">/5</span></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-green-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Support Rating</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @avg_support %><span class="text-sm text-gray-400">/5</span></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-blue-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">Recommendation Rate</p>
        <p class="text-xl font-bold text-gray-900 mt-1"><%= @recommendation_rate %>%</p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-purple-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.5c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 012.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 00.322-1.672V3a.75.75 0 01.75-.75A2.25 2.25 0 0116.5 4.5c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 01-2.649 7.521c-.388.482-.987.729-1.605.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 00-1.423-.23H5.904M14.25 9h2.25M5.904 18.75c.083.205.173.405.27.602.197.4-.078.898-.523.898h-.908c-.889 0-1.713-.518-1.972-1.368a12 12 0 01-.521-3.507c0-1.553.295-3.036.831-4.398C3.387 10.203 4.167 9.75 5 9.75h1.053c.472 0 .745.556.5.96a8.958 8.958 0 00-1.302 4.665c0 1.194.232 2.333.654 3.375z" /></svg>
      </div>
    </div>
  </div>
</div>

<!-- Rating Distributions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Service Rating Distribution</h3>
    <% if @service_distribution.any? %>
      <div class="space-y-3">
        <% (5).downto(1).each do |rating| %>
          <% data = @service_distribution[rating] || { count: 0, percentage: 0 } %>
          <div class="flex items-center gap-3">
            <span class="text-xs text-gray-500 w-12"><%= rating %> star</span>
            <div class="flex-1 bg-gray-100 rounded-full h-2.5">
              <div class="bg-yellow-400 h-2.5 rounded-full" style="width: <%= data[:percentage] %>%"></div>
            </div>
            <span class="text-xs text-gray-500 w-16 text-right"><%= data[:count] %> (<%= data[:percentage] %>%)</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 text-center py-4">No data yet.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Support Rating Distribution</h3>
    <% if @support_distribution.any? %>
      <div class="space-y-3">
        <% (5).downto(1).each do |rating| %>
          <% data = @support_distribution[rating] || { count: 0, percentage: 0 } %>
          <div class="flex items-center gap-3">
            <span class="text-xs text-gray-500 w-12"><%= rating %> star</span>
            <div class="flex-1 bg-gray-100 rounded-full h-2.5">
              <div class="bg-blue-400 h-2.5 rounded-full" style="width: <%= data[:percentage] %>%"></div>
            </div>
            <span class="text-xs text-gray-500 w-16 text-right"><%= data[:count] %> (<%= data[:percentage] %>%)</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 text-center py-4">No data yet.</p>
    <% end %>
  </div>
</div>

<!-- All Responses for this Agent -->
<div class="rounded-xl border border-gray-200 bg-white">
  <div class="p-5 border-b border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900">All Responses</h3>
  </div>
  <% if @agent_responses.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Respondent</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Type</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Service</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Support</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Recommend</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Feedback</th>
          <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-500 uppercase">Date</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @agent_responses.each do |response| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-xs font-medium text-gray-900"><%= response.respondent&.name || "Anonymous" %></td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= response.respondent_type || "—" %></td>
            <td class="px-4 py-3"><%= star_display(response.service_rating) %></td>
            <td class="px-4 py-3"><%= star_display(response.support_rating) %></td>
            <td class="px-4 py-3">
              <% if response.would_recommend %>
                <span class="inline-flex items-center rounded-full border border-green-200 bg-green-50 px-2 py-0.5 text-[11px] font-medium text-green-700">Yes</span>
              <% else %>
                <span class="inline-flex items-center rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-700">No</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500 max-w-xs">
              <% if response.improvement_suggestion.present? %>
                <p class="truncate" title="<%= response.improvement_suggestion %>"><%= truncate(response.improvement_suggestion, length: 50) %></p>
              <% end %>
              <% if response.additional_comments.present? %>
                <p class="truncate text-gray-400 mt-0.5" title="<%= response.additional_comments %>"><%= truncate(response.additional_comments, length: 50) %></p>
              <% end %>
              <% if response.improvement_suggestion.blank? && response.additional_comments.blank? %>
                <span class="text-gray-400">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= response.submitted_at.strftime("%d %b %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="border-t border-gray-200 px-4 py-3">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-xs text-gray-500">No responses yet for this agent.</p>
    </div>
  <% end %>
</div>
