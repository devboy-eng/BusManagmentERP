<% content_for :page_title, "Inspection Details" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Inspection Report</h2>
    <p class="text-xs text-gray-500 mt-1">Job Card: <%= @job_card.job_card_number %> | Inspected: <%= @inspection.inspected_at&.strftime("%d %b %Y, %I:%M %p") %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to job_card_path(@job_card), class: "inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 py-2.5 text-xs font-medium text-gray-600 hover:bg-gray-100 transition" do %>
      Back to Job Card
    <% end %>
  </div>
</div>

<div class="space-y-6">
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Overview</h3>
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Overall Condition</dt>
        <dd class="mt-1">
          <% condition_colors = { "good" => "bg-green-100 text-green-800", "fair" => "bg-yellow-100 text-yellow-800", "needs_attention" => "bg-orange-100 text-orange-800", "critical" => "bg-red-100 text-red-800" } %>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= condition_colors[@inspection.overall_condition] || 'bg-gray-100 text-gray-800' %>">
            <%= @inspection.overall_condition&.humanize %>
          </span>
        </dd>
      </div>
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Inspected By</dt>
        <dd class="text-xs text-gray-900 mt-1"><%= @inspection.inspected_by&.name %></dd>
      </div>
      <div class="rounded-lg bg-gray-50 p-3">
        <dt class="text-[11px] text-gray-500">Date</dt>
        <dd class="text-xs text-gray-900 mt-1"><%= @inspection.inspected_at&.strftime("%d %b %Y, %I:%M %p") %></dd>
      </div>
    </dl>
    <% if @inspection.general_notes.present? %>
      <div class="rounded-lg bg-gray-50 p-3 mt-4">
        <dt class="text-[11px] text-gray-500">General Notes</dt>
        <dd class="text-xs text-gray-900 mt-1"><%= @inspection.general_notes %></dd>
      </div>
    <% end %>
  </div>

  <!-- Inspection Items -->
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-4">Inspection Items</h3>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Area</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Condition</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @inspection.inspection_items.each do |item| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 text-xs text-gray-900 font-medium"><%= item.area %></td>
              <td class="px-4 py-2">
                <% item_colors = { "good" => "bg-green-100 text-green-800", "fair" => "bg-yellow-100 text-yellow-800", "needs_attention" => "bg-orange-100 text-orange-800", "critical" => "bg-red-100 text-red-800" } %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= item_colors[item.condition] || 'bg-gray-100 text-gray-800' %>">
                  <%= item.condition&.humanize %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs text-gray-600"><%= item.notes || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
